<UserControl x:Class="LinxLauncher.Controls.WorkbenchTemplate"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRow" Height="Auto" />
            <RowDefinition x:Name="CommandRow" Height="Auto" />
            <RowDefinition x:Name="WorkspaceRow" Height="*" />
            <RowDefinition x:Name="FooterRow" Height="Auto" />
        </Grid.RowDefinitions>

        <ContentPresenter x:Name="HeaderPresenter"
                          Grid.Row="0"
                          Content="{x:Bind HeaderContent, Mode=OneWay}"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch" />

        <Border x:Name="CommandSurfaceHost" Grid.Row="1">
            <ContentPresenter x:Name="CommandPresenter"
                              Content="{x:Bind CommandContent, Mode=OneWay}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch" />
        </Border>

        <SplitView x:Name="WorkspaceSplitView"
                   Grid.Row="2"
                   PanePlacement="Right"
                   DisplayMode="Inline"
                   IsPaneOpen="True"
                   OpenPaneLength="320"
                   PaneBackground="{ThemeResource WorkbenchPopupBrush}">
            <SplitView.Pane>
                <Grid x:Name="PaneHost"
                      Padding="12,0,12,8"
                      MinWidth="0"
                      RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <NavigationView x:Name="PaneNavigation"
                                    Style="{StaticResource WorkbenchPaneNavigationViewStyle}"
                                    AlwaysShowHeader="False"
                                    HorizontalAlignment="Stretch"
                                    MinWidth="0"
                                    SelectionChanged="PaneNavigation_SelectionChanged">
                        <NavigationView.Resources>
                            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                            <Thickness x:Key="TopNavigationViewContentGridBorderThickness">0</Thickness>
                            <Thickness x:Key="TopNavigationViewTopNavGridMargin">0</Thickness>
                        </NavigationView.Resources>
                    </NavigationView>
                    <!-- 标签只占标题行；内容直接使用 PaneHost 的剩余宽高，保留 Frame 原生转场。 -->
                    <Frame x:Name="PaneContentFrame"
                           Grid.Row="1"
                           Background="Transparent"
                           HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           VerticalContentAlignment="Stretch"
                           MinWidth="0" />
                </Grid>
            </SplitView.Pane>

            <Border x:Name="ViewportSurface"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Margin="0,0,8,0">
                <ContentPresenter x:Name="ViewportPresenter"
                                  Content="{x:Bind ViewportContent, Mode=OneWay}"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  VerticalContentAlignment="Stretch" />
            </Border>
        </SplitView>

        <ContentPresenter x:Name="FooterPresenter"
                          Grid.Row="3"
                          Content="{x:Bind FooterContent, Mode=OneWay}"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch" />
    </Grid>
</UserControl>
