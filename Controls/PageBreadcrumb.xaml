<UserControl
    x:Class="LinxLauncher.Controls.PageBreadcrumb"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <BreadcrumbBar x:Name="Breadcrumbs" ItemClicked="Breadcrumbs_ItemClicked"
                   HorizontalAlignment="Stretch" AutomationProperties.Name="页面层级">
        <BreadcrumbBar.Resources>
            <x:Double x:Key="BreadcrumbBarItemThemeFontSize">28</x:Double>
            <x:Double x:Key="BreadcrumbBarChevronFontSize">16</x:Double>
            <Thickness x:Key="BreadcrumbBarChevronPadding">10,0</Thickness>
        </BreadcrumbBar.Resources>
        <BreadcrumbBar.ItemTemplate>
            <!-- 原生控件会用 null 创建省略号占位项，自身绑定需允许空值。 -->
            <DataTemplate>
                <BreadcrumbBarItem Content="{Binding}" FontFamily="{StaticResource DisplayFontFamily}">
                    <BreadcrumbBarItem.ContentTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="28" LineHeight="36"
                                       TextTrimming="CharacterEllipsis" Loaded="Label_Loaded"
                                       DataContextChanged="Label_DataContextChanged"
                                       PointerEntered="Label_PointerEntered" PointerExited="Label_PointerExited" />
                        </DataTemplate>
                    </BreadcrumbBarItem.ContentTemplate>
                </BreadcrumbBarItem>
            </DataTemplate>
        </BreadcrumbBar.ItemTemplate>
    </BreadcrumbBar>
</UserControl>
