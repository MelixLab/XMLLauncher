<?xml version="1.0" encoding="utf-8"?>
<!--
    首页、联机与工具箱共享的功能卡片：
    · 表面和边缘的柔和追光共用指针位置，背景状态只绘制一次
    · 原生导航按钮与内部操作各自接收输入，避免重复点击与整卡双重缩放
    · 图标 48×48，走 IconTemplate（主图形 + 状态徽章）
-->
<UserControl
    x:Class="LinxLauncher.Controls.FeatureCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    CornerRadius="4"
    MinHeight="258"
    mc:Ignorable="d">

    <Grid
        x:Name="Root"
        Background="{ThemeResource CardBackgroundBrush}"
        CornerRadius="{x:Bind CornerRadius, Mode=OneWay}">

        <Border CornerRadius="{x:Bind CornerRadius, Mode=OneWay}" IsHitTestVisible="False" x:Name="HoverFill" Background="{ThemeResource CardHoverBackgroundBrush}" Opacity="0">
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.15" />
            </Border.OpacityTransition>
        </Border>
        <Border CornerRadius="{x:Bind CornerRadius, Mode=OneWay}" IsHitTestVisible="False"
                x:Name="PressedFill" Background="{ThemeResource CardPressedBackgroundBrush}" Opacity="0" />

        <!-- 原生导航按钮与 Actions 是兄弟元素，避免嵌套按钮吞掉点击与焦点。 -->
        <Button x:Name="NavigationButton" Visibility="Collapsed" Click="Navigation_Click"
                CornerRadius="{x:Bind CornerRadius, Mode=OneWay}"
                Style="{StaticResource FeatureCardNavigationButtonStyle}"
                AutomationProperties.Name="{x:Bind Header, Mode=OneWay}">
            <Button.Resources>
                <!-- 只借用原生按钮的输入与焦点；卡片表面统一由外层绘制。 -->
                <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
            </Button.Resources>
        </Button>
        <Border IsHitTestVisible="False" CornerRadius="{x:Bind CornerRadius, Mode=OneWay}"
                x:Name="SurfaceGlow" Opacity="0" />
        <!-- 描边与表面共享外轮廓；放在独立层，避免根容器边框使 Reveal 内缩。 -->
        <Border IsHitTestVisible="False" CornerRadius="{x:Bind CornerRadius, Mode=OneWay}"
                BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1" />
        <Border IsHitTestVisible="False" CornerRadius="{x:Bind CornerRadius, Mode=OneWay}" x:Name="RevealStroke" BorderThickness="1" Opacity="0">
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.10" />
            </Border.OpacityTransition>
        </Border>

        <!--
            等宽面板按行同高；状态区吸收剩余空间，操作区始终贴齐底部。
        -->
        <Grid Margin="21,17,21,17">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 图标容器要比图标本身大，否则 56 的图塞进 48 的框会被裁掉一条边 -->
            <ContentControl
                Grid.Row="0"
                IsHitTestVisible="False"
                Width="56"
                Height="56"
                HorizontalAlignment="Left"
                Content="."
                ContentTemplate="{x:Bind IconTemplate, Mode=OneWay}" />

            <TextBlock
                IsHitTestVisible="False"
                Grid.Row="1"
                Margin="0,22,0,0"
                Style="{StaticResource CardTitleTextStyle}"
                Text="{x:Bind Header, Mode=OneWay}" />

            <TextBlock
                IsHitTestVisible="False"
                Grid.Row="2"
                Margin="0,2,0,0"
                MinHeight="{x:Bind StatusMinHeight, Mode=OneWay}"
                Style="{StaticResource CardStatusTextStyle}"
                Text="{x:Bind Status, Mode=OneWay}" />

            <ContentPresenter
                Grid.Row="3"
                Margin="0,14,0,0"
                HorizontalAlignment="Left"
                Content="{x:Bind Actions, Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
