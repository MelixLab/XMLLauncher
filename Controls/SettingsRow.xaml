<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="LinxLauncher.Controls.SettingsRow">
    <Grid x:Name="Layout" ColumnSpacing="20" RowSpacing="10" SizeChanged="Layout_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid x:Name="LabelHost" ColumnSpacing="16" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <FontIcon x:Name="LeadingIcon" FontFamily="{StaticResource IconFontFamily}" FontSize="20"
                      Width="24" Foreground="{ThemeResource PrimaryTextBrush}" Visibility="Collapsed"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                <TextBlock x:Name="TitleText" Style="{StaticResource CardTitleTextStyle}"/>
                <TextBlock x:Name="DescriptionText" Style="{StaticResource CaptionTextStyle}"/>
            </StackPanel>
        </Grid>
        <ContentPresenter x:Name="EditorHost" Grid.Column="1" VerticalAlignment="Center" HorizontalContentAlignment="Stretch"/>
    </Grid>
</UserControl>
