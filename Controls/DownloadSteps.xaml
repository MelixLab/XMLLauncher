<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LinxLauncher.Controls.DownloadSteps"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:LinxLauncher.Services"
    xmlns:local="using:LinxLauncher.Controls">

    <!-- 下载页、历史记录和安装弹窗共享真实阶段及终态反馈。 -->
    <StackPanel x:Name="ContentRoot" Spacing="10">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon
                x:Name="StatusIcon"
                VerticalAlignment="Top"
                FontSize="16"
                Glyph="&#xE896;" />
            <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock
                    x:Name="StatusText"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource PrimaryTextBrush}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="StageText"
                    Style="{StaticResource CaptionTextStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <ProgressBar
            x:Name="Progress"
            Height="4"
            Minimum="0"
            Maximum="100"
            AutomationProperties.Name="当前阶段进度" />

        <local:AdaptiveWrapPanel x:Name="MetricsHost" Spacing="16">
            <TextBlock x:Name="SpeedText" Style="{StaticResource CaptionTextStyle}" />
            <TextBlock x:Name="SizeText" Style="{StaticResource CaptionTextStyle}" />
            <TextBlock x:Name="PercentText" Style="{StaticResource CaptionTextStyle}" />
            <TextBlock x:Name="FilesText" Style="{StaticResource CaptionTextStyle}" />
        </local:AdaptiveWrapPanel>

        <TextBlock
            x:Name="FileText"
            FontSize="12"
            Foreground="{ThemeResource TertiaryTextBrush}"
            MaxLines="2"
            TextTrimming="CharacterEllipsis"
            TextWrapping="Wrap" />

        <Border
            services:CardAppearance.IsCard="True"
            x:Name="ErrorPanel"
            Padding="12"
            Background="{ThemeResource CardBackgroundBrush}"
            BorderBrush="{ThemeResource DividerBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Visibility="Collapsed">
            <TextBlock
                x:Name="ErrorText"
                FontSize="13"
                Foreground="{ThemeResource SecurityRedBrush}"
                IsTextSelectionEnabled="True"
                TextWrapping="Wrap" />
        </Border>
    </StackPanel>
</UserControl>
