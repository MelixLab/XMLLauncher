<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LinxLauncher.Controls.DownloadSteps"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:LinxLauncher.Services">

    <!--
        下载页、历史记录和安装弹窗共享的阶段显示。

        排版原则：一行只说一件事。
        · 状态行 = 图标 + 「状态 · 阶段」，不再拆成两行同义文字
        · 指标合成一行，用 · 分隔，没有的项直接不出现
        · 结束后收起进度条与速度，不留空白
    -->
    <StackPanel x:Name="ContentRoot" Spacing="9">

        <!-- 状态行 -->
        <Grid ColumnSpacing="9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <FontIcon
                x:Name="StatusIcon"
                VerticalAlignment="Center"
                FontSize="14"
                Glyph="&#xE896;" />

            <TextBlock
                x:Name="StatusText"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="13.5"
                FontWeight="SemiBold"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </Grid>

        <!-- 进度条：仅运行中 -->
        <ProgressBar
            x:Name="Progress"
            Height="3"
            Minimum="0"
            Maximum="100"
            AutomationProperties.Name="当前阶段进度" />

        <!-- 指标：速度 · 已下载 / 总量 · 百分比 -->
        <TextBlock
            x:Name="MetricsText"
            FontSize="12.5"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap" />

        <!-- 当前文件：只有和标题不同时才显示，避免同一个文件名出现两次 -->
        <TextBlock
            x:Name="FileText"
            FontSize="12"
            MaxLines="2"
            TextTrimming="CharacterEllipsis"
            TextWrapping="Wrap" />

        <!-- 失败原因 -->
        <Border
            services:CardAppearance.IsCard="True"
            x:Name="ErrorPanel"
            Padding="11"
            Background="{ThemeResource CardBackgroundBrush}"
            BorderBrush="{ThemeResource DividerBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Visibility="Collapsed">
            <TextBlock
                x:Name="ErrorText"
                FontSize="12.5"
                Foreground="{ThemeResource SecurityRedBrush}"
                IsTextSelectionEnabled="True"
                TextWrapping="Wrap" />
        </Border>
    </StackPanel>
</UserControl>
