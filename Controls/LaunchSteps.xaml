<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LinxLauncher.Controls.LaunchSteps"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        启动进度的统一呈现：刻意和 DownloadSteps 用同一套骨架
        （固定步骤 + 细进度条 + 底部两行指标），下载和启动两个窗口看起来是一家。
    -->
    <StackPanel Spacing="10">
        <StackPanel x:Name="StepsHost" Spacing="9" />

        <ProgressBar
            x:Name="Progress"
            Height="3"
            Margin="0,8,0,0"
            CornerRadius="0" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="ElapsedText"
                FontSize="12.5"
                Foreground="{ThemeResource SecondaryTextBrush}"
                Text="已用时 0 秒" />
            <TextBlock
                x:Name="StatusText"
                Grid.Column="1"
                Margin="16,0,0,0"
                FontSize="12.5"
                Foreground="{ThemeResource SecondaryTextBrush}"
                Text="正在启动" />
            <TextBlock
                x:Name="PercentText"
                Grid.Column="2"
                FontSize="12.5"
                Foreground="{ThemeResource SecondaryTextBrush}"
                Text="0%" />
        </Grid>

        <TextBlock
            x:Name="DetailText"
            FontSize="12"
            Foreground="{ThemeResource TertiaryTextBrush}"
            Text="准备中…"
            TextTrimming="CharacterEllipsis" />
    </StackPanel>
</UserControl>
