<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="LinxLauncher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="XML Minecraft Launcher"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource PaneBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="TitleBarStrip"
            Height="32"
            Grid.Row="0"
            Background="Transparent">
            <TextBlock
                x:Name="TitleBarTitle"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource SecondaryTextBrush}"
                Text="XML Minecraft Launcher" />
        </Grid>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            AlwaysShowHeader="False"
            Background="Transparent"
            CompactModeThresholdWidth="0"
            CompactPaneLength="48"
            ExpandedModeThresholdWidth="0"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="False"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="212"
            PaneDisplayMode="LeftCompact"
            SelectionChanged="NavView_SelectionChanged">

            <NavigationView.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Light">
                            <!--
                                LeftCompact 下这两个资源的分工是反的（参考项目实测过）：
                                  · 收起态 48 DIP 图标栏 ← NavigationViewExpandedPaneBackground
                                  · 展开后的浮层        ← NavigationViewDefaultPaneBackground
                                所以收起要给透明（直接露出窗口底色，和标题栏连成一块），
                                展开时才是一块浅灰浮层。
                            -->
                            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#F2F2F2" />
                            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                            <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#00A88E" />
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#F6F6F6" />
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#EDEDED" />
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#E6E6E6" />
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#EDEDED" />
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#E6E6E6" />
                            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#1B1B1B" />
                            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#1B1B1B" />
                            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#1B1B1B" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Dark">
                            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#2B2B2B" />
                            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                            <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#35D4BA" />
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#12332D" />
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#17403A" />
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#1C4C45" />
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#2A2A2A" />
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#323232" />
                            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#E8E8E8" />
                            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#87EAD8" />
                            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#FFFFFF" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="概览" Tag="overview">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="版本库" Tag="versions">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="下载" Tag="downloads">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Mod 下载" Tag="mods">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="联机" Tag="relay">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE704;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="社区" Tag="community">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8BD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="工具箱" Tag="tools">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="设置" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.PaneFooter>
                <Grid x:Name="AccountHost" Margin="4,4,4,10">
                    <Button
                        x:Name="AccountButton"
                        Padding="8,6"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="AccountButton_Click"
                        CornerRadius="4"
                        ToolTipService.ToolTip="账户与皮肤">
                        <Grid x:Name="AccountGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition x:Name="AccountTextColumn" Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 头像：圆形。有自定义图片就用图片铺满，否则回到首字母 -->
                            <Grid
                                x:Name="AvatarHost"
                                Width="30"
                                Height="30"
                                HorizontalAlignment="Left">
                                <Ellipse x:Name="AvatarCircle" Fill="{ThemeResource BrandBrush}" />
                                <TextBlock
                                    x:Name="AvatarText"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="S" />
                                <Ellipse x:Name="AvatarImage" Visibility="Collapsed">
                                    <Ellipse.Fill>
                                        <ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>

                            <StackPanel
                                x:Name="AccountTexts"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="AccountName"
                                    FontSize="13"
                                    Foreground="{ThemeResource PrimaryTextBrush}"
                                    Text="Steve"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="AccountSubtitle"
                                    FontSize="11"
                                    Foreground="{ThemeResource SecondaryTextBrush}"
                                    Text="离线账号" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>
            </NavigationView.PaneFooter>

            <!-- 内容面板：比标题栏略暗一档（#FDFDFD）+ 左上 8 DIP 圆角 + 上/左细描边 -->
            <Border
                Background="{ThemeResource PageLayerBackgroundBrush}"
                BorderBrush="{ThemeResource PageLayerBorderBrush}"
                BorderThickness="1,1,0,0"
                CornerRadius="8,0,0,0">
                <Grid>
                    <Frame x:Name="ContentFrame" Background="Transparent" />
                </Grid>
            </Border>
        </NavigationView>
    </Grid>
</Window>
