<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
  

    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>LinxLauncher</RootNamespace>
    <!-- 默认版本与当前发布基线一致；发版时可用 -p:Version=... 覆盖。 -->
    <VersionPrefix>1.1.5</VersionPrefix>
    <!-- exe 的版本资源：通知、文件属性、任务栏都读这里的名字 -->
    <Product>XML Minecraft Launcher</Product>
    <AssemblyTitle>XML Minecraft Launcher</AssemblyTitle>
    <Company>Xigua Studio</Company>
    <Description>XML Minecraft Launcher</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <!-- VS 的构建进程位数可能与目标平台不同，优先使用项目选定的平台。 -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x86'">win-x86</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- 公开文件清单：新增运行资源或公开文档时显式登记，禁止递归复制本地资料。 -->
    <LauncherAsset Include="Assets\AppIcon.ico" />
    <LauncherAsset Include="Assets\Blocks\anvil.png" />
    <LauncherAsset Include="Assets\Blocks\book.png" />
    <LauncherAsset Include="Assets\Blocks\clock.png" />
    <LauncherAsset Include="Assets\Blocks\command.png" />
    <LauncherAsset Include="Assets\Blocks\fabric.png" />
    <LauncherAsset Include="Assets\Blocks\forge.png" />
    <LauncherAsset Include="Assets\Blocks\neoforge.png" />
    <LauncherAsset Include="Assets\Blocks\quilt.png" />
    <LauncherAsset Include="Assets\Blocks\vanilla.png" />
    <LauncherAsset Include="Assets\LockScreenLogo.scale-200.png" />
    <LauncherAsset Include="Assets\Skins\Alex.png" />
    <LauncherAsset Include="Assets\Skins\Steve.png" />
    <LauncherAsset Include="Assets\SplashScreen.scale-200.png" />
    <LauncherAsset Include="Assets\Square150x150Logo.scale-200.png" />
    <LauncherAsset Include="Assets\Square44x44Logo.scale-200.png" />
    <LauncherAsset Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <LauncherAsset Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <LauncherAsset Include="Assets\StoreLogo.png" />
    <LauncherAsset Include="Assets\Wide310x150Logo.scale-200.png" />
    <LauncherPublicDocument Include="README.md" />
    <LauncherPublicDocument Include="LICENSE" />
    <LauncherPublicDocument Include="THIRD-PARTY-NOTICES.md" />
    <LauncherPublicDocument Include="LINX.Logo.png" />
    <LauncherPublicDocument Include="docs\memory-performance.md" />
    <LauncherPublicDocument Include="docs\settings-design.md" />
    <Content Include="@(LauncherAsset);@(LauncherPublicDocument)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Pack="false" />
    <!-- NuGet 包根目录的许可证不会自动复制；仅列出随本程序分发所需的上游声明。 -->
    <Content Include="$(PkgRZeroF1_Minecraft_SeedMap)\licenses\cubiomes\LICENSE;$(PkgRZeroF1_Minecraft_SeedMap)\licenses\cubiomes\SOURCE.md;$(PkgRZeroF1_Minecraft_SeedMap)\licenses\cubiomes\manifest.json"
             Link="licenses\cubiomes\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="false" />
    <Content Include="$(PkgRZeroF1_Minecraft_Projection)\licenses\minecraft-renderer\LICENSE;$(PkgRZeroF1_Minecraft_Projection)\licenses\minecraft-renderer\SOURCE.md"
             Link="licenses\minecraft-renderer\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="false" />
    <Content Include="$(PkgRZeroF1_Minecraft_Projection)\licenses\schematic-editor\LICENSE;$(PkgRZeroF1_Minecraft_Projection)\licenses\schematic-editor\SOURCE.md"
             Link="licenses\schematic-editor\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="false" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.7.1" />
    <PackageReference Include="RZeroF1.Minecraft.SeedMap" Version="0.2.1" GeneratePathProperty="true" />
    <PackageReference Include="RZeroF1.Minecraft.Projection" Version="0.1.1" GeneratePathProperty="true" />
  </ItemGroup>

  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <Target Name="RejectUnsupportedSeedMapRid"
          BeforeTargets="Build"
          Condition="'$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'win-x64'">
    <Error Text="XMLLauncher 的 SeedMap 功能通过 RZeroF1.Minecraft.SeedMap 仅支持 win-x64；当前 RuntimeIdentifier=$(RuntimeIdentifier)。请使用 win-x64，或在没有种子地图功能的独立项目中构建其他平台。" />
  </Target>
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>

    <!-- WinUI 3 + Native AOT：不开这个，ObservableCollection 到 ItemsControl.ItemsSource
         的封送会走反射，被裁掉之后 set_ItemsSource 直接抛 ArgumentException -->
    <CsWinRTAotOptimizerEnabled>true</CsWinRTAotOptimizerEnabled>
  </PropertyGroup>

  <!--
    Native AOT（可选）：
        dotnet publish -c Release -r win-x64 -p:PublishAot=true -p:SelfContained=true

    产物是原生 exe（约 15 MB），没有 coreclr.dll，冷启动更快。要守住三条：
      1) 所有 JSON 读写必须走 Services/AppJsonContext.cs 里登记过的类型；
         新增模型忘了登记，AOT 版会在运行时抛 NotSupportedException（普通构建看不出来）。
      2) Assets 下的图片必须显式挂成 Content（见上面 Blocks 那条），
         否则 publish 输出里不带这个目录，界面图标会整片消失。
      3) 列表 / 模板里被 {Binding} 绑定的模型类要标 [Microsoft.UI.Xaml.Data.Bindable]，
         否则裁剪掉属性元数据后，一设 ItemsSource 就抛
         ArgumentException: Value does not fall within the expected range。
    发布完确认一下 <输出目录>\Assets\Blocks\*.png 都在。
  -->
</Project>
