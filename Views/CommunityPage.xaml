<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LinxLauncher.Views.CommunityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource PageLayerBackgroundBrush}"
    mc:Ignorable="d">

    <!--
        这一页只用 WinUI 自带控件：
          SelectorBar  页签（自带指示条动画）
          ListView     帖子 / 会话 / 消息（原生滚动、hover、选中、键盘操作）
          PersonPicture 头像（自动圆形裁剪，没图就显示首字母）
          Button / AccentButtonStyle / TextBox 原生外观
        DataTemplate 里只用 {Binding}，不用 x:Bind —— 本项目里
        「模板 + x:Bind 本地类型」会让 XamlCompiler 崩掉。
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 标题 ==================== -->
        <Grid Padding="36,28,28,0">
            <StackPanel>
                <TextBlock
                    FontSize="26"
                    LineHeight="34"
                    Style="{StaticResource PageTitleTextStyle}"
                    Text="社区" />
                <TextBlock
                    Margin="0,8,0,0"
                    MaxWidth="620"
                    HorizontalAlignment="Left"
                    Style="{StaticResource PageSubtitleTextStyle}"
                    Text="广场里都是 XML 玩家：问问题、晒存档、找搭子。" />
            </StackPanel>

            <Button
                x:Name="ComposeButton"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Click="Compose_Click"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock Text="发帖" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- ==================== 页签（原生 SelectorBar） ==================== -->
        <SelectorBar
            x:Name="CommunityTabs"
            Grid.Row="1"
            Margin="36,10,28,0"
            SelectionChanged="Tabs_SelectionChanged">
            <SelectorBarItem x:Name="PlazaTab" IsSelected="True" Text="广场" />
            <SelectorBarItem x:Name="DmTab" Text="私信" />
        </SelectorBar>

        <!-- ==================== 内容 ==================== -->
        <Grid Grid.Row="2">

            <!-- 广场 -->
            <Grid x:Name="PlazaView">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Padding="36,10,28,6">
                    <StackPanel
                        x:Name="TagRow"
                        Orientation="Horizontal"
                        Spacing="6" />

                    <StackPanel
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">
                        <TextBlock
                            x:Name="MetaText"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource CardStatusTextStyle}" />
                        <Button
                            x:Name="SortNewButton"
                            Padding="10,3"
                            Click="Sort_Click"
                            Content="最新"
                            Tag="new" />
                        <Button
                            x:Name="SortHotButton"
                            Padding="10,3"
                            Click="Sort_Click"
                            Content="热度"
                            Tag="hot" />
                        <Button
                            x:Name="SortMineButton"
                            Padding="10,3"
                            Click="Sort_Click"
                            Content="我的帖子"
                            Tag="mine"
                            Visibility="Collapsed" />
                        <Button
                            x:Name="RefreshButton"
                            Padding="10,3"
                            Click="Refresh_Click"
                            Content="刷新" />
                    </StackPanel>
                </Grid>

                <ListView
                    x:Name="PostList"
                    Grid.Row="1"
                    Padding="36,0,28,16"
                    IsItemClickEnabled="True"
                    ItemClick="PostList_ItemClick"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="0,12" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <PersonPicture
                                    Width="38"
                                    Height="38"
                                    VerticalAlignment="Top"
                                    DisplayName="{Binding Author}"
                                    ProfilePicture="{Binding AvatarUrl}" />

                                <StackPanel Grid.Column="1" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource PrimaryTextBrush}"
                                            Text="{Binding Author}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{ThemeResource SecondaryTextBrush}"
                                            Text="{Binding TimeText}" />
                                        <Border
                                            Padding="5,1"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource BrandSoftBrush}"
                                            CornerRadius="3"
                                            Visibility="{Binding PinnedVisibility}">
                                            <TextBlock
                                                FontSize="10.5"
                                                Foreground="{ThemeResource LinkTextBrush}"
                                                Text="置顶" />
                                        </Border>
                                        <Border
                                            Padding="5,1"
                                            VerticalAlignment="Center"
                                            Background="{Binding StatusBackground}"
                                            CornerRadius="3"
                                            Visibility="{Binding StatusVisibility}">
                                            <TextBlock
                                                FontSize="10.5"
                                                Foreground="{Binding StatusForeground}"
                                                Text="{Binding StatusLabel}" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource PrimaryTextBrush}"
                                        MaxLines="2"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{ThemeResource SecondaryTextBrush}"
                                        MaxLines="2"
                                        Text="{Binding Excerpt}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />

                                    <StackPanel
                                        Margin="0,2,0,0"
                                        Orientation="Horizontal"
                                        Spacing="2">
                                        <Button
                                            Padding="8,2"
                                            Click="Like_Click"
                                            Tag="{Binding Id}"
                                            ToolTipService.ToolTip="点赞">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon FontSize="13" Glyph="&#xE8E1;" />
                                                <TextBlock FontSize="12" Text="{Binding LikeText}" />
                                            </StackPanel>
                                        </Button>

                                        <Button
                                            Padding="8,2"
                                            Click="Comment_Click"
                                            Tag="{Binding Id}"
                                            ToolTipService.ToolTip="查看评论">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon FontSize="13" Glyph="&#xE90A;" />
                                                <TextBlock FontSize="12" Text="{Binding CommentText}" />
                                            </StackPanel>
                                        </Button>

                                        <TextBlock
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{ThemeResource SecondaryTextBrush}"
                                            Text="{Binding ViewText}" />

                                        <Button
                                            Padding="8,2"
                                            Click="Report_Click"
                                            Tag="{Binding Id}"
                                            ToolTipService.ToolTip="举报这条帖子">
                                            <FontIcon FontSize="13" Glyph="&#xE7BA;" />
                                        </Button>

                                        <Border
                                            Margin="8,0,0,0"
                                            Padding="7,2"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource CardHoverBackgroundBrush}"
                                            CornerRadius="3">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{ThemeResource SecondaryTextBrush}"
                                                Text="{Binding TagLabel}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- 状态层：加载 / 空 / 错误 -->
                <StackPanel
                    x:Name="StateHost"
                    Grid.Row="1"
                    Margin="36,48,36,0"
                    VerticalAlignment="Top"
                    Spacing="10"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="StateText"
                        MaxWidth="520"
                        HorizontalAlignment="Left"
                        Foreground="{ThemeResource SecondaryTextBrush}"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="StateAction"
                        Click="StateAction_Click"
                        Content="重试"
                        Visibility="Collapsed" />
                </StackPanel>

                <ProgressRing
                    x:Name="LoadingRing"
                    Grid.Row="1"
                    Width="22"
                    Height="22"
                    Margin="0,40,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    IsActive="False"
                    Visibility="Collapsed" />

                <Button
                    x:Name="MoreButton"
                    Grid.Row="1"
                    Margin="0,0,0,16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Click="More_Click"
                    Content="加载更多"
                    Visibility="Collapsed" />
            </Grid>

            <!-- 私信 -->
            <Grid x:Name="DmView" Margin="36,0,28,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 会话列表 -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,14,6,0">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource PrimaryTextBrush}"
                            Text="会话" />
                        <Button
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="NewDm_Click"
                            Content="新对话"
                            Padding="10,3" />
                    </Grid>

                    <TextBlock
                        x:Name="DmHint"
                        Grid.Row="1"
                        Margin="0,8,6,0"
                        FontSize="11.5"
                        Foreground="{ThemeResource SecondaryTextBrush}"
                        TextWrapping="Wrap" />

                    <ListView
                        x:Name="ThreadList"
                        Grid.Row="2"
                        Margin="0,6,0,6"
                        Padding="0"
                        SelectionChanged="ThreadList_SelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,6" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <PersonPicture
                                        Width="36"
                                        Height="36"
                                        DisplayName="{Binding Peer}"
                                        ProfilePicture="{Binding AvatarUrl}" />

                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource PrimaryTextBrush}"
                                            Text="{Binding Peer}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="11.5"
                                            Foreground="{ThemeResource SecondaryTextBrush}"
                                            MaxLines="1"
                                            Text="{Binding Preview}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Spacing="3">
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontSize="10.5"
                                            Foreground="{ThemeResource SecondaryTextBrush}"
                                            Text="{Binding TimeText}" />
                                        <Border
                                            MinWidth="18"
                                            Padding="5,0"
                                            HorizontalAlignment="Right"
                                            Background="{ThemeResource BrandBrush}"
                                            CornerRadius="9"
                                            Visibility="{Binding UnreadVisibility}">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="10.5"
                                                Foreground="{ThemeResource OnBrandTextBrush}"
                                                Text="{Binding UnreadText}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Border Grid.Column="1" Background="{ThemeResource DividerBrush}" />

                <!-- 聊天区 -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid
                        x:Name="ChatHeader"
                        Padding="22,12,22,10"
                        Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <PersonPicture
                            x:Name="ChatAvatar"
                            Width="36"
                            Height="36"
                            VerticalAlignment="Center" />

                        <StackPanel
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock
                                x:Name="ChatName"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource PrimaryTextBrush}"
                                Text="" />
                            <TextBlock
                                x:Name="ChatSub"
                                FontSize="11.5"
                                Foreground="{ThemeResource SecondaryTextBrush}"
                                Text="" />
                        </StackPanel>
                    </Grid>

                    <Border
                        x:Name="ChatHeaderDivider"
                        Grid.Row="0"
                        Height="1"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource DividerBrush}"
                        Visibility="Collapsed" />

                    <ListView
                        x:Name="MessageList"
                        Grid.Row="1"
                        Padding="18,8,18,8"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    MaxWidth="440"
                                    Margin="{Binding BubbleMargin}"
                                    Padding="12,8"
                                    HorizontalAlignment="{Binding Align}"
                                    Background="{Binding BubbleBackground}"
                                    CornerRadius="10">
                                    <StackPanel Spacing="3">
                                        <TextBlock
                                            FontSize="13.5"
                                            Foreground="{Binding BubbleForeground}"
                                            IsTextSelectionEnabled="True"
                                            Text="{Binding Body}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            FontSize="10.5"
                                            Foreground="{Binding BubbleForeground}"
                                            Opacity="0.65"
                                            Text="{Binding TimeText}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel
                        x:Name="ChatEmpty"
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">
                        <FontIcon
                            FontSize="30"
                            Foreground="{ThemeResource SecondaryTextBrush}"
                            Glyph="&#xE8BD;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="13"
                            Foreground="{ThemeResource SecondaryTextBrush}"
                            Text="选左边的会话开始聊，或者点「新对话」找人。" />
                    </StackPanel>

                    <Grid
                        x:Name="ChatComposer"
                        Grid.Row="2"
                        Margin="18,0,18,16"
                        Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            x:Name="ChatInput"
                            MinHeight="40"
                            MaxLength="2000"
                            PlaceholderText="写点什么…"
                            KeyDown="ChatInput_KeyDown" />

                        <Button
                            x:Name="ChatSend"
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Click="ChatSend_Click"
                            Content="发送"
                            Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
