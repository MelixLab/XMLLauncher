<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LinxLauncher.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LinxLauncher.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <!--
        下载中心：与安装对话框同一套进度呈现（DownloadSteps：固定五步 + 细进度条 + 速度 + 当前文件）。
        历史记录沿用 Defender「保护历史记录」那种灰直角行。
    -->
    <Grid Padding="40,40,40,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="下载" />
                <TextBlock
                    Margin="0,11,0,0"
                    Style="{StaticResource PageSubtitleTextStyle}"
                    Text="安装进度、当前文件与传输速率。任务在后台继续，切页不会中断。" />
            </StackPanel>
            <Button
                x:Name="ClearButton"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Click="Clear_Click"
                Content="清除已完成"
                Visibility="Collapsed" />
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            Margin="0,24,0,0"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            HorizontalContentAlignment="Stretch"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 当前任务 -->
                <Border
                    x:Name="ActivePanel"
                    Padding="20,18"
                    Background="{ThemeResource CardBackgroundBrush}"
                    BorderBrush="{ThemeResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <TextBlock
                            x:Name="JobTitle"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource PrimaryTextBrush}"
                            Text="—"
                            TextTrimming="CharacterEllipsis" />

                        <controls:DownloadSteps x:Name="Steps" />
                    </StackPanel>
                </Border>

                <!-- 空态 -->
                <Border
                    x:Name="EmptyPanel"
                    Padding="20,44"
                    Background="{ThemeResource CardBackgroundBrush}"
                    BorderBrush="{ThemeResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel HorizontalAlignment="Center" Spacing="6">
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontSize="26"
                            Foreground="{ThemeResource SecondaryTextBrush}"
                            Glyph="&#xE896;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource BodyTextStyle}"
                            Text="当前没有下载任务" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource CaptionTextStyle}"
                            Text="到版本库挑一个版本，点「下载并安装」。" />
                        <Button
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            Click="GoVersions_Click"
                            Content="打开版本库" />
                    </StackPanel>
                </Border>

                <!-- 历史 -->
                <TextBlock
                    x:Name="HistoryTitle"
                    Margin="0,24,0,10"
                    Style="{StaticResource SectionTitleTextStyle}"
                    Text="历史记录"
                    Visibility="Collapsed" />

                <ListView
                    x:Name="HistoryList"
                    SelectionMode="None"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollMode="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,2" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="CornerRadius" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="20,14"
                                Background="Transparent"
                                BorderBrush="{ThemeResource DividerBrush}"
                                BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Foreground="{ThemeResource SecurityGreenBrush}"
                                        Glyph="&#xE73E;" />

                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="14,0,0,0"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            Style="{StaticResource BodyTextStyle}"
                                            Text="{Binding Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Margin="0,3,0,0"
                                            Style="{StaticResource CardStatusTextStyle}"
                                            Text="{Binding SizeText}" />
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CardStatusTextStyle}"
                                        Text="{Binding StatusText}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
