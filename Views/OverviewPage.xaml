<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LinxLauncher.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LinxLauncher.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer Style="{StaticResource PageScrollStyle}">
        <Grid x:Name="CardHost" Background="Transparent" Style="{StaticResource PageContentStyle}" MaxWidth="1104"
              SizeChanged="CardHost_SizeChanged"
              PointerExited="CardHost_PointerExited">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="概览" />
                <TextBlock Style="{StaticResource PageSubtitleTextStyle}"
                           Text="了解本机的 Minecraft 版本、模组加载器与下载情况，并进行必要操作。" />
            </StackPanel>
            <controls:AdaptiveWrapPanel Background="Transparent" Grid.Row="1" Margin="0,28,0,0"
                                        ItemMinWidth="232" MaxColumns="3" Spacing="8" ContentPadding="6,4,6,4">
                <controls:FeatureCard
                    x:Name="VersionCard"
                    IconTemplate="{StaticResource IconCardGame}"
                    NavTag="versions">
                    <controls:FeatureCard.Actions>
                        <!-- 点这里弹出小浮窗选版本，选哪个就直接启动哪个 -->
                        <Button
                            Click="VersionPick_Click"
                            Content="选择版本"
                            Style="{StaticResource CardActionButtonStyle}" />
                    </controls:FeatureCard.Actions>
                </controls:FeatureCard>

                <controls:FeatureCard
                    x:Name="LoaderCard"
                    IconTemplate="{StaticResource IconCardLoader}"
                    NavTag="versions">
                    <controls:FeatureCard.Actions>
                        <Button
                            Click="GoVersions_Click"
                            Content="安装加载器"
                            Style="{StaticResource CardActionButtonStyle}" />
                    </controls:FeatureCard.Actions>
                </controls:FeatureCard>

                <controls:FeatureCard
                    x:Name="SpeedCard"
                    IconTemplate="{StaticResource IconCardDownload}"
                    NavTag="settings">
                    <controls:FeatureCard.Actions>
                        <Button
                            Click="GoSettings_Click"
                            Content="下载设置"
                            Style="{StaticResource CardActionButtonStyle}" />
                    </controls:FeatureCard.Actions>
                </controls:FeatureCard>

                <controls:FeatureCard
                    x:Name="InstalledCard"
                    IconTemplate="{StaticResource IconCardLibrary}"
                    NavTag="versions">
                    <controls:FeatureCard.Actions>
                        <Button
                            Click="GoInstalled_Click"
                            Content="管理版本"
                            Style="{StaticResource CardActionButtonStyle}" />
                    </controls:FeatureCard.Actions>
                </controls:FeatureCard>

                <controls:FeatureCard
                    x:Name="JavaCard"
                    IconTemplate="{StaticResource IconCardJava}"
                    NavTag="settings">
                    <controls:FeatureCard.Actions>
                        <Button
                            Click="GoSettings_Click"
                            Content="更换 Java"
                            Style="{StaticResource CardActionButtonStyle}" />
                    </controls:FeatureCard.Actions>
                </controls:FeatureCard>

                <controls:FeatureCard
                    x:Name="TaskCard"
                    IconTemplate="{StaticResource IconCardTask}"
                    NavTag="downloads">
                    <controls:FeatureCard.Actions>
                        <Button
                            Click="GoDownloads_Click"
                            Content="查看任务"
                            Style="{StaticResource CardActionButtonStyle}" />
                    </controls:FeatureCard.Actions>
                </controls:FeatureCard>
            </controls:AdaptiveWrapPanel>
        </Grid>
    </ScrollViewer>
</Page>
