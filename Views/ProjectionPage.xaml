<Page
    x:Class="LinxLauncher.Views.ProjectionPage"
    NavigationCacheMode="Enabled"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop"
    KeyDown="Page_KeyDown"
    KeyUp="Page_KeyUp"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LinxLauncher.Controls">

    <Grid x:Name="Root"
          Background="Transparent"
          Padding="16,12,16,12"
          RowSpacing="8">
        <controls:WorkbenchTemplate x:Name="WorkspaceTemplate"
                                    InlinePaneLength="380"
                                    OverlayPaneLength="320">
            <controls:WorkbenchTemplate.HeaderContent>
                <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="1">
                                <TextBlock Style="{StaticResource PageTitleTextStyle}"
                                           FontSize="24"
                                           Text="3D 投影工作台" />
                                <TextBlock x:Name="FileText"
                                           Style="{StaticResource PageSubtitleTextStyle}"
                                           Text="请选择一个投影文件"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock x:Name="ViewportHeaderStatusText"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Text="等待载入"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
            </controls:WorkbenchTemplate.HeaderContent>
            <controls:WorkbenchTemplate.CommandContent>
                <CommandBar x:Name="WorkspaceCommands" Style="{StaticResource WorkbenchCommandBarStyle}">
                            <AppBarButton Label="打开投影" Click="OpenProjection_Click">
                                <AppBarButton.Icon>
                                    <SymbolIcon Symbol="OpenFile" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton x:Name="CaptureButton"
                                          Label="导出 PNG"
                                          Click="Capture_Click"
                                          IsEnabled="False">
                                <AppBarButton.Icon>
                                    <SymbolIcon Symbol="Save" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton Label="相机">
                                <AppBarButton.Icon>
                                    <SymbolIcon Symbol="Camera" />
                                </AppBarButton.Icon>
                                <AppBarButton.Flyout>
                                    <Flyout x:Name="CameraFlyout" FlyoutPresenterStyle="{StaticResource WorkbenchFlyoutStyle}">
                                        <StackPanel Width="236" Spacing="8">
                                            <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                                       FontSize="16"
                                                       Text="相机" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="复位视角"
                                                        Click="ResetCamera_Click"
                                                        HorizontalAlignment="Stretch" />
                                                <Button Content="聚焦模型"
                                                        Click="FocusModel_Click"
                                                        HorizontalAlignment="Stretch" />
                                            </StackPanel>
                                            <ToggleButton x:Name="FreeCameraButton"
                                                          Content="探索模式"
                                                          Click="FreeCamera_Click" />
                                            <ComboBox x:Name="MoveSpeedBox"
                                                      Header="移动速度"
                                                      SelectionChanged="MoveSpeed_SelectionChanged">
                                                <ComboBoxItem Content="慢速" />
                                                <ComboBoxItem Content="正常" />
                                                <ComboBoxItem Content="加速" />
                                            </ComboBox>
                                            <TextBlock x:Name="CameraModeText"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Text="环绕模式" />
                                            <TextBlock x:Name="CameraHelpText"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Text="左键旋转 · 右键平移 · 滚轮缩放"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Flyout>
                                </AppBarButton.Flyout>
                            </AppBarButton>
                            <AppBarToggleButton x:Name="SliceToggleButton"
                                                Label="切面"
                                                Click="SliceCommand_Click"
                                                IsEnabled="False">
                                <AppBarToggleButton.Icon>
                                    <SymbolIcon Symbol="ViewAll" />
                                </AppBarToggleButton.Icon>
                            </AppBarToggleButton>
                            <AppBarButton Label="资源">
                                <AppBarButton.Icon>
                                    <SymbolIcon Symbol="Library" />
                                </AppBarButton.Icon>
                                <AppBarButton.Flyout>
                                    <Flyout x:Name="ResourceFlyout" FlyoutPresenterStyle="{StaticResource WorkbenchFlyoutStyle}">
                                        <StackPanel Width="250" Spacing="8">
                                            <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                                       FontSize="16"
                                                       Text="资源来源" />
                                            <Button Content="叠加资源包"
                                                    Click="PickPack_Click"
                                                    HorizontalAlignment="Left" />
                                            <TextBlock x:Name="ResourceText"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Text="资源包：未选择"
                                                       TextWrapping="Wrap" />
                                            <TextBlock x:Name="ClientText"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Text="正在读取已配置的 Minecraft 版本…"
                                                       TextWrapping="Wrap" />
                                            <StackPanel x:Name="ClientActionPanel"
                                                        Orientation="Horizontal"
                                                        Spacing="8"
                                                        Visibility="Collapsed">
                                                <Button Content="去设置游戏目录"
                                                        Click="OpenSettings_Click" />
                                                <Button Content="去版本库"
                                                        Click="OpenVersions_Click" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Flyout>
                                </AppBarButton.Flyout>
                            </AppBarButton>
                            <AppBarToggleButton x:Name="PanelButton"
                                                Label="面板"
                                                Icon="OpenPane"
                                                Click="Panel_Click"
                                                IsChecked="False" />
                        </CommandBar>
            </controls:WorkbenchTemplate.CommandContent>
            <controls:WorkbenchTemplate.PaneMenuItems>
                <NavigationViewItem Content="材料" Tag="Materials" IsSelected="True" />
                <NavigationViewItem Content="信息" Tag="Info" />
            </controls:WorkbenchTemplate.PaneMenuItems>
            <controls:WorkbenchTemplate.PaneContent>
                    <Grid x:Name="SideToolPanelHost" MinWidth="0">
                                            <Grid x:Name="MaterialsPanel" RowSpacing="8" MinWidth="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <TextBlock x:Name="MaterialSummaryText" MinWidth="0"
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           Text="等待载入投影"
                                                           TextWrapping="Wrap" />

                                                <TextBox x:Name="MaterialSearchBox" MinWidth="0"
                                                         Grid.Row="1"
                                                         Header="搜索材料"
                                                         PlaceholderText="名称、ID 或状态"
                                                         TextChanged="MaterialSearch_TextChanged" />

                                                <Grid Grid.Row="2" ColumnSpacing="8" MinWidth="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" MinWidth="0" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox x:Name="MaterialScopeBox" MinWidth="0"
                                                              Header="统计"
                                                              SelectionChanged="MaterialScope_SelectionChanged">
                                                        <ComboBoxItem Content="完整投影" />
                                                        <ComboBoxItem Content="当前剖切" />
                                                    </ComboBox>
                                                    <ComboBox x:Name="MaterialSortBox" Grid.Column="1" MinWidth="0"
                                                              Header="排序"
                                                              SelectionChanged="MaterialSort_SelectionChanged">
                                                        <ComboBoxItem Content="数量" />
                                                        <ComboBoxItem Content="名称" />
                                                    </ComboBox>
                                                    <StackPanel x:Name="MaterialViewBar" MinWidth="0"
                                                                Grid.Column="2"
                                                                VerticalAlignment="Bottom"
                                                                Orientation="Horizontal"
                                                                Spacing="4">
                                                        <ToggleButton x:Name="MaterialGridButton" MinWidth="0"
                                                                      Content="网格"
                                                                      IsChecked="True"
                                                                      Click="MaterialView_Click"
                                                                      Padding="8,4" />
                                                        <ToggleButton x:Name="MaterialListButton" MinWidth="0"
                                                                      Content="列表"
                                                                      Click="MaterialView_Click"
                                                                      Padding="8,4" />
                                                    </StackPanel>
                                                </Grid>

                                                <Expander x:Name="MaterialDetailExpander"
                                                          Grid.Row="3"
                                                          Header="材料详情"
                                                          IsExpanded="False"
                                                          Visibility="Collapsed">
                                                    <StackPanel x:Name="MaterialDetailContent"
                                                                Spacing="6" />
                                                </Expander>

                                                <Grid Grid.Row="4" MinWidth="0">
                                                    <ListView x:Name="MaterialsList" MinWidth="0"
                                                              SelectionMode="None"
                                                              IsItemClickEnabled="False"
                                                              HorizontalContentAlignment="Stretch"
                                                              Padding="0"
                                                              Visibility="Collapsed" />
                                                    <GridView x:Name="MaterialsGrid" MinWidth="0"
                                                              SelectionMode="None"
                                                              IsItemClickEnabled="False"
                                                              HorizontalAlignment="Stretch"
                                                              HorizontalContentAlignment="Stretch"
                                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                              ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                                </Grid>
                                            </Grid>

                                            <ScrollViewer x:Name="InfoPanel" MinWidth="0"
                                                          HorizontalAlignment="Stretch"
                                                          HorizontalContentAlignment="Stretch"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          Visibility="Collapsed"
                                                          VerticalScrollBarVisibility="Auto">
                                                <StackPanel Spacing="10" MinWidth="0" HorizontalAlignment="Stretch">
                                                    <controls:WorkbenchAcrylicCard CardPadding="12"
                                                                                    MinWidth="0"
                                                                                    HorizontalAlignment="Stretch">
                                                        <StackPanel Spacing="6" MinWidth="0">
                                                            <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                                                       FontSize="18"
                                                                       Text="文件与资源" />
                                                            <TextBlock x:Name="FileSummaryText"
                                                                       Style="{StaticResource CaptionTextStyle}"
                                                                       Text="未载入文件"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock x:Name="ResourceSummaryText"
                                                                       Style="{StaticResource CaptionTextStyle}"
                                                                       Text="资源包：未选择"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </controls:WorkbenchAcrylicCard>

                                                    <controls:WorkbenchAcrylicCard CardPadding="12"
                                                                                    MinWidth="0"
                                                                                    HorizontalAlignment="Stretch">
                                                        <StackPanel Spacing="6" MinWidth="0">
                                                            <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                                                       FontSize="18"
                                                                       Text="模型摘要" />
                                                            <TextBlock x:Name="InfoText"
                                                                       Style="{StaticResource CaptionTextStyle}"
                                                                       Text="尺寸：—&#x0a;非空气方块：—&#x0a;DataVersion：—"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </controls:WorkbenchAcrylicCard>

                                                    <Expander x:Name="DetailsExpander" MinWidth="0"
                                                              Header="详细信息"
                                                              IsExpanded="False">
                                                        <TextBlock x:Name="DetailsText"
                                                                   Style="{StaticResource CaptionTextStyle}"
                                                                   Text="Region 和 Palette 详情将在载入后显示。"
                                                                   TextWrapping="Wrap" />
                                                    </Expander>

                                                    <Expander x:Name="DiagnosticsExpander" MinWidth="0"
                                                              Header="技术诊断"
                                                              IsExpanded="False">
                                                        <StackPanel Spacing="8" MinWidth="0">
                                                            <TextBlock x:Name="MemoryText"
                                                                       Style="{StaticResource CaptionTextStyle}"
                                                                       Text="本进程内存：等待采样"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock x:Name="WarningText"
                                                                       Style="{StaticResource NoticeTextStyle}"
                                                                       Visibility="Collapsed"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Expander>
                                                </StackPanel>
                                            </ScrollViewer>
                    </Grid>
            </controls:WorkbenchTemplate.PaneContent>
            <controls:WorkbenchTemplate.ViewportContent>
                <Grid>
                    <Grid x:Name="ViewportPanel"
                                                    IsTabStop="True"
                                                    PointerPressed="Viewport_PointerPressed"
                                                    PointerMoved="Viewport_PointerMoved"
                                                    PointerReleased="Viewport_PointerReleased"
                                                    PointerCanceled="Viewport_PointerReleased"
                                                    PointerWheelChanged="Viewport_PointerWheelChanged"
                                                    SizeChanged="Viewport_SizeChanged">
                        <Grid.Background>
                            <ImageBrush x:Name="ViewportBrush" Stretch="Fill" />
                        </Grid.Background>
                    </Grid>

                    <ProgressRing x:Name="ViewportLoadingRing"
                                  Width="36"
                                  Height="36"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsActive="False"
                                  IsHitTestVisible="False"
                                  Visibility="Collapsed"
                                  AutomationProperties.Name="正在初始化 3D 预览" />

                                    <Border HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Margin="12"
                                            Padding="10,7"
                                            Background="#99000000"
                                            CornerRadius="5">
                                        <TextBlock x:Name="ViewportStatusText"
                                                   Foreground="White"
                                                   Text="请选择一个投影文件。"
                                                   TextWrapping="Wrap" />
                                    </Border>

                    <controls:WorkbenchAcrylicCard x:Name="SliceTool"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Bottom"
                                                   Margin="12"
                                                   CardPadding="10"
                                                   Visibility="Collapsed">
                                        <StackPanel MaxWidth="320" MinWidth="0" Spacing="7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource BodyStrongTextStyle}"
                                                           Text="切面" />
                                                <TextBlock x:Name="SliceAppliedText"
                                                           Grid.Column="1"
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           Text="完整模型" />
                                            </Grid>

                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="SliceModeBox"
                                                          Header="模式"
                                                          SelectionChanged="SliceMode_SelectionChanged">
                                                    <ComboBoxItem Content="完整模型" />
                                                    <ComboBoxItem Content="当前单层" />
                                                    <ComboBoxItem Content="范围剖切" />
                                                </ComboBox>
                                                <Button Grid.Column="1"
                                                        Content="恢复完整"
                                                        VerticalAlignment="Bottom"
                                                        Click="ClearSlice_Click" />
                                            </Grid>

                                            <StackPanel x:Name="SliceAxisBar"
                                                        Orientation="Horizontal"
                                                        Spacing="4">
                                                <ToggleButton x:Name="SliceAxisXButton"
                                                              Content="X"
                                                              Click="SliceAxis_Click"
                                                              Padding="12,4" />
                                                <ToggleButton x:Name="SliceAxisYButton"
                                                              Content="Y"
                                                              IsChecked="True"
                                                              Click="SliceAxis_Click"
                                                              Padding="12,4" />
                                                <ToggleButton x:Name="SliceAxisZButton"
                                                              Content="Z"
                                                              Click="SliceAxis_Click"
                                                              Padding="12,4" />
                                            </StackPanel>

                                            <Grid x:Name="SingleSlicePanel" ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="SliceMinusButton"
                                                        Content="−"
                                                        Tag="-1"
                                                        Click="SliceStep_Click"
                                                        ToolTipService.ToolTip="上一层" />
                                                <Slider x:Name="SliceSlider"
                                                        Grid.Column="1"
                                                        Minimum="0"
                                                        Maximum="1"
                                                        StepFrequency="1"
                                                        ValueChanged="SliceSlider_ValueChanged" />
                                                <Button x:Name="SlicePlusButton"
                                                        Grid.Column="2"
                                                        Content="+"
                                                        Tag="1"
                                                        Click="SliceStep_Click"
                                                        ToolTipService.ToolTip="下一层" />
                                            </Grid>

                                            <Grid x:Name="SingleSliceValuePanel" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="112" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <NumberBox x:Name="SliceValueBox"
                                                           Header="当前坐标"
                                                           SpinButtonPlacementMode="Compact"
                                                           ValueChanged="SliceValue_ValueChanged" />
                                                <TextBlock x:Name="SliceRangeText"
                                                           Grid.Column="1"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           Text="范围：—"
                                                           TextWrapping="Wrap" />
                                            </Grid>

                                            <Expander x:Name="SliceRangeExpander"
                                                      Header="范围剖切"
                                                      Visibility="Collapsed">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <NumberBox x:Name="SliceMinBox"
                                                               Header="最小值"
                                                               SpinButtonPlacementMode="Compact"
                                                               ValueChanged="SliceRange_ValueChanged" />
                                                    <NumberBox x:Name="SliceMaxBox"
                                                               Grid.Column="1"
                                                               Header="最大值"
                                                               SpinButtonPlacementMode="Compact"
                                                               ValueChanged="SliceRange_ValueChanged" />
                                                </Grid>
                                            </Expander>

                                            <TextBlock x:Name="SlicePendingText"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Text="拖动滑块可逐层查看"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                    </controls:WorkbenchAcrylicCard>

                                    <Border HorizontalAlignment="Left"
                                            VerticalAlignment="Bottom"
                                            Margin="12"
                                            Padding="9,6"
                                            Background="#99000000"
                                            CornerRadius="5">
                                        <TextBlock Foreground="White"
                                                   FontSize="12"
                                                   Text="拖入 .litematic / .schem 可直接打开"
                                                   TextWrapping="Wrap" />
                                    </Border>
                </Grid>
            </controls:WorkbenchTemplate.ViewportContent>
            <controls:WorkbenchTemplate.FooterContent>
                <TextBlock
                                   x:Name="LoadStatusText"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Text="等待载入"
                                   TextTrimming="CharacterEllipsis" />
            </controls:WorkbenchTemplate.FooterContent>
        </controls:WorkbenchTemplate>
    </Grid>
</Page>
