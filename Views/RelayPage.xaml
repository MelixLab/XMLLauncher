<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LinxLauncher.Views.RelayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LinxLauncher.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource PageLayerBackgroundBrush}"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="40,36,40,40" HorizontalAlignment="Left" Spacing="0">

            <!-- 标题 -->
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="联机" />
                <TextBlock
                    Margin="0,11,0,0"
                    Style="{StaticResource PageSubtitleTextStyle}"
                    Text="点对点直连：服务器只帮你们交换地址，游戏数据不经过服务器。" />
            </StackPanel>

            <!-- 第一行：三张入口卡片，和首页一个样式 -->
            <Grid
                x:Name="CardHost"
                Margin="0,36,0,0"
                HorizontalAlignment="Left"
                ColumnSpacing="8"
                PointerMoved="CardHost_PointerMoved"
                PointerExited="CardHost_PointerExited">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="232" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="232" />
                </Grid.ColumnDefinitions>

                <controls:FeatureCard
                    x:Name="HostCard"
                    StatusMinHeight="38"
                    Grid.Column="0"
                    Height="258"
                    IconTemplate="{StaticResource IconCardGame}"
                    Header="开启新世界"
                    Status="把你的局域网世界挂到大厅，朋友点进来就能直接连上。">
                    <controls:FeatureCard.Actions>
                        <Button
                            x:Name="HostButton"
                            Content="开房间"
                            Style="{StaticResource CardActionButtonStyle}"
                            Click="Host_Click" />
                    </controls:FeatureCard.Actions>
                </controls:FeatureCard>

                <controls:FeatureCard
                    x:Name="LobbyCard"
                    StatusMinHeight="38"
                    Grid.Column="2"
                    Height="258"
                    IconTemplate="{StaticResource IconCardLibrary}"
                    Header="公开房间"
                    Status="看看大厅里现在有谁开着世界，点一下就能进去。">
                    <controls:FeatureCard.Actions>
                        <Button
                            Content="浏览大厅"
                            Style="{StaticResource CardActionButtonStyle}"
                            Click="Browse_Click" />
                    </controls:FeatureCard.Actions>
                </controls:FeatureCard>

                <controls:FeatureCard
                    x:Name="JoinCard"
                    StatusMinHeight="38"
                    Grid.Column="4"
                    Height="258"
                    IconTemplate="{StaticResource IconCardDownload}"
                    Header="加入房间"
                    Status="有房间号就直接输进来，走 P2P 直连，延迟就是你们两家之间。">
                    <controls:FeatureCard.Actions>
                        <Button
                            x:Name="JoinButton"
                            Content="输入房间号"
                            Style="{StaticResource CardActionButtonStyle}"
                            Click="Join_Click" />
                    </controls:FeatureCard.Actions>
                </controls:FeatureCard>
            </Grid>

            <!-- 网络状态（小字，不抢卡片位置） -->
            <StackPanel Margin="2,18,0,0" Orientation="Horizontal" Spacing="12">
                <TextBlock x:Name="NatText" Style="{StaticResource CardStatusTextStyle}" Text="网络检测中…" VerticalAlignment="Center" />
                <TextBlock x:Name="PublicAddrText" Style="{StaticResource CardStatusTextStyle}" Text="" VerticalAlignment="Center" />
                <HyperlinkButton Padding="0" Click="Redetect_Click" Content="重新检测" FontSize="12" />
            </StackPanel>

            <TextBlock
                Margin="2,8,0,0"
                MaxWidth="920"
                HorizontalAlignment="Left"
                Style="{StaticResource CardStatusTextStyle}"
                Text="双方都是「对称型 NAT」（部分 4G/5G、校园网）时打洞会失败，这种网络不支持 P2P 联机；全锥形 / 受限锥形 / 端口受限锥形都可以。"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
