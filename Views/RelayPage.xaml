<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LinxLauncher.Views.RelayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource PageLayerBackgroundBrush}"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="760"
            Padding="40,36,40,40"
            HorizontalAlignment="Left"
            Spacing="16">

            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="联机" />
                <TextBlock
                    Style="{StaticResource PageSubtitleTextStyle}"
                    Text="房主开好局域网世界后生成连接码，对方输入连接码即可进同一个世界（走官方服务器中继）。"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- 开房间 -->
            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundBrush}"
                BorderBrush="{ThemeResource DividerBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="我是房主" />
                    <TextBlock
                        Style="{StaticResource CaptionTextStyle}"
                        Text="流程：进游戏 → 对局域网开放。联机码会自动出现，发给朋友即可。"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Style="{StaticResource CaptionTextStyle}"
                        Text="联机码自动生成，只要不乱点就一直是这个，直接发给朋友。" />

                    <TextBlock
                        x:Name="HostCode"
                        Margin="0,4,0,0"
                        FontFamily="{StaticResource DisplayFontFamily}"
                        FontSize="44"
                        Foreground="{ThemeResource BrandBrush}"
                        IsTextSelectionEnabled="True"
                        Text="" />

                    <TextBlock
                        x:Name="HostReadyText"
                        Style="{StaticResource CaptionTextStyle}"
                        Text="" />

                    <TextBlock
                        x:Name="HostGuestText"
                        Style="{StaticResource CaptionTextStyle}"
                        Foreground="{ThemeResource BrandBrush}"
                        Text="" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox
                            x:Name="VersionBox"
                            Width="220"
                            DisplayMemberPath="Id"
                            PlaceholderText="选择要联机的版本" />
                        <Button
                            x:Name="StopHostButton"
                            Click="Stop_Click"
                            Content="结束联机"
                            Visibility="Collapsed" />
                    </StackPanel>

                    <TextBlock
                        x:Name="HostStatus"
                        FontSize="12.5"
                        Foreground="{ThemeResource SecondaryTextBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 加入房间 -->
            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundBrush}"
                BorderBrush="{ThemeResource DividerBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="我是访客" />
                    <TextBlock
                        Style="{StaticResource CaptionTextStyle}"
                        Text="输入朋友给你的 6 位联机码，然后按上面给出的地址进游戏。"
                        TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox
                            x:Name="CodeBox"
                            Width="160"
                            MaxLength="6"
                            PlaceholderText="6 位连接码" />
                        <Button
                            x:Name="JoinButton"
                            Click="Join_Click"
                            Content="加入房间"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            x:Name="LeaveButton"
                            Click="Stop_Click"
                            Content="断开"
                            Visibility="Collapsed" />
                    </StackPanel>

                    <TextBlock
                        x:Name="GuestAddress"
                        Margin="0,4,0,0"
                        FontFamily="{StaticResource DisplayFontFamily}"
                        FontSize="22"
                        Foreground="{ThemeResource BrandBrush}"
                        IsTextSelectionEnabled="True"
                        Visibility="Collapsed" />

                    <StackPanel
                        x:Name="GuestSteps"
                        Spacing="3"
                        Visibility="Collapsed">
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="在游戏里这样连：" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="1. 启动和自己版本一致的客户端" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="2. 主菜单 → 多人游戏 → 添加服务器" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="3. 服务器地址填上面这串（含端口）" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="4. 双击进服；如果被踢，说明两边模组或版本不一致" />
                    </StackPanel>

                    <TextBlock
                        x:Name="GuestStatus"
                        FontSize="12.5"
                        Foreground="{ThemeResource SecondaryTextBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
