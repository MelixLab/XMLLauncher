<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LinxLauncher.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="40,40,40,48" HorizontalAlignment="Left" Spacing="8">

            <StackPanel Margin="0,0,0,16">
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="设置" />
                <TextBlock
                    Margin="0,11,0,0"
                    Style="{StaticResource PageSubtitleTextStyle}"
                    Text="游戏目录、启动参数与下载行为。改动保存在本机配置里。" />
            </StackPanel>

            <!-- 新手向导：随时可以重看 -->
            <TextBlock
                Margin="0,8,0,4"
                Style="{StaticResource SectionTitleTextStyle}"
                Text="新手向导" />
            <Grid
                Width="560"
                Margin="0,0,0,6"
                HorizontalAlignment="Left"
                ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock Style="{StaticResource BodyTextStyle}" Text="重新看一遍入门引导" />
                    <TextBlock
                        Style="{StaticResource CaptionTextStyle}"
                        Text="依次介绍登录方式、XML 账号和侧栏六个页面。过程中不会下载任何文件，也不会改动版本库。"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Click="RestartWizard_Click"
                    Content="重新开始向导" />
            </Grid>

            <!-- 游戏目录 -->
            <TextBlock
                Margin="0,8,0,4"
                Style="{StaticResource SectionTitleTextStyle}"
                Text="游戏目录" />
            <TextBlock
                Margin="0,0,0,8"
                Style="{StaticResource CaptionTextStyle}"
                Text="所有版本、依赖库与资源文件都放在这个目录下。" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="460" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="GameDirBox" IsReadOnly="True" />
                <Button
                    Grid.Column="1"
                    Click="Browse_Click"
                    Content="浏览…" />
            </Grid>

            <!-- 从其它启动器导入 -->
            <TextBlock
                Margin="0,24,0,4"
                Style="{StaticResource SectionTitleTextStyle}"
                Text="从其它启动器导入" />
            <TextBlock
                Margin="0,0,0,8"
                Style="{StaticResource CaptionTextStyle}"
                Text="自动识别 PCL2 / HMCL / 官方启动器用的 .minecraft 目录，把里面的版本、存档和模组复制过来（不覆盖已有的）。"
                TextWrapping="Wrap" />
            <StackPanel x:Name="ImportHost" Spacing="6" />
            <StackPanel
                Margin="0,4,0,0"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Click="RefreshImport_Click"
                    Content="重新检测" />
                <Button
                    Click="ChooseImportDir_Click"
                    Content="选择其它文件夹…" />
            </StackPanel>

            <!-- 启动 -->
            <TextBlock
                Margin="0,24,0,4"
                Style="{StaticResource SectionTitleTextStyle}"
                Text="启动" />
            <TextBlock
                Margin="0,0,0,12"
                Style="{StaticResource CaptionTextStyle}"
                Text="玩家名、内存与 Java 运行时。" />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="玩家名（离线）" />
                    <TextBox x:Name="PlayerNameBox" MaxLength="16" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="Java 运行时" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Name="JavaBox"
                            HorizontalAlignment="Stretch" />
                        <Button
                            Grid.Column="1"
                            Click="RescanJava_Click"
                            Content="重新检测" />
                    </Grid>
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,16,0,0" Spacing="6">
                <Grid>
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="内存分配（MB）" />
                    <TextBlock
                        x:Name="MemoryValue"
                        HorizontalAlignment="Right"
                        Style="{StaticResource MetricValueTextStyle}" />
                </Grid>
                <Slider
                    x:Name="MemorySlider"
                    Maximum="16384"
                    Minimum="1024"
                    StepFrequency="512"
                    ValueChanged="Memory_Changed"
                    Width="520"
                    HorizontalAlignment="Left" />
            </StackPanel>

            <!-- 下载 -->
            <TextBlock
                Margin="0,24,0,4"
                Style="{StaticResource SectionTitleTextStyle}"
                Text="下载" />
            <Grid Margin="0,4,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyTextStyle}" Text="使用国内镜像（BMCLAPI）" />
                    <TextBlock
                        Style="{StaticResource CaptionTextStyle}"
                        Text="关闭后直连 Mojang 官方源，国内通常较慢。" />
                </StackPanel>
                <ToggleSwitch
                    x:Name="MirrorSwitch"
                    HorizontalAlignment="Right"
                    Toggled="Mirror_Toggled" />
            </Grid>

            <StackPanel Spacing="6">
                <Grid>
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="并发下载线程" />
                    <TextBlock
                        x:Name="ThreadValue"
                        HorizontalAlignment="Right"
                        Style="{StaticResource MetricValueTextStyle}" />
                </Grid>
                <Slider
                    x:Name="ThreadSlider"
                    Maximum="24"
                    Minimum="2"
                    StepFrequency="1"
                    ValueChanged="Thread_Changed"
                    Width="520"
                    HorizontalAlignment="Left" />
            </StackPanel>

            <!-- 外观 -->
            <TextBlock
                Margin="0,24,0,4"
                Style="{StaticResource SectionTitleTextStyle}"
                Text="外观" />
            <Grid Margin="0,4,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyTextStyle}" Text="正文使用 Noto Sans 字体" />
                    <TextBlock
                        Style="{StaticResource CaptionTextStyle}"
                        Text="正文换成 Noto Sans，页面标题保持不变。" />
                </StackPanel>
                <ToggleSwitch
                    x:Name="FontSwitch"
                    HorizontalAlignment="Right"
                    Toggled="Font_Toggled" />
            </Grid>

            <!-- 窗口 -->
            <TextBlock
                Margin="0,24,0,4"
                Style="{StaticResource SectionTitleTextStyle}"
                Text="游戏窗口" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="宽" />
                    <NumberBox x:Name="WidthBox" Minimum="320" Maximum="7680" SpinButtonPlacementMode="Compact" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="高" />
                    <NumberBox x:Name="HeightBox" Minimum="240" Maximum="4320" SpinButtonPlacementMode="Compact" />
                </StackPanel>
                <ToggleSwitch
                    x:Name="FullscreenSwitch"
                    Grid.Column="2"
                    Margin="8,22,0,0"
                    Header="全屏启动" />
            </Grid>

            <!-- 高级 -->
            <TextBlock
                Margin="0,24,0,4"
                Style="{StaticResource SectionTitleTextStyle}"
                Text="高级" />
            <StackPanel Spacing="6" Margin="0,0,0,8">
                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="额外 JVM 参数（留空即可）" />
                <TextBox
                    x:Name="JvmArgsBox"
                    AcceptsReturn="True"
                    Height="60"
                    TextWrapping="Wrap"
                    Width="520"
                    HorizontalAlignment="Left" />
                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="额外游戏参数" />
                <TextBox
                    x:Name="GameArgsBox"
                    AcceptsReturn="True"
                    Height="60"
                    TextWrapping="Wrap"
                    Width="520"
                    HorizontalAlignment="Left" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
                <Button
                    Click="Save_Click"
                    Content="保存设置"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button Click="OpenLogs_Click" Content="打开日志目录" />
                <TextBlock
                    x:Name="SavedText"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource SecurityGreenBrush}"
                    Text="已保存"
                    Visibility="Collapsed" />
            </StackPanel>

            <TextBlock
                Margin="0,24,0,0"
                Style="{StaticResource CaptionTextStyle}"
                x:Name="AboutText" />
        </StackPanel>
    </ScrollViewer>
</Page>
