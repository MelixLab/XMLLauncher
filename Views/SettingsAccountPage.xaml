<?xml version="1.0" ?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:LinxLauncher.Controls" x:Class="LinxLauncher.Views.SettingsAccountPage" NavigationCacheMode="Required" Background="Transparent">
    <ScrollViewer Style="{StaticResource SettingsScrollStyle}">
        <StackPanel Spacing="16">
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="XML 账户" Style="{StaticResource SettingsSectionStyle}"/>
                    <TextBlock Text="联机大厅、云端存档和广场使用此账户。它与主导航「账户」中进入游戏的正版 / 离线身份相互独立。" Style="{StaticResource CaptionTextStyle}"/>
                    <StackPanel x:Name="XmlSignedIn" Spacing="12" Visibility="Collapsed">
                        <TextBlock x:Name="XmlNameText" Style="{StaticResource BodyStrongTextStyle}"/>
                        <controls:AdaptiveWrapPanel Spacing="8">
                            <Button Content="换头像" Click="XmlAvatar_Click"/>
                            <Button Content="管理账户" Click="XmlManage_Click"/>
                            <Button Content="退出登录" Click="XmlLogout_Click"/>
                        </controls:AdaptiveWrapPanel>
                    </StackPanel>
                    <StackPanel x:Name="XmlSignedOut" Spacing="16">
                        <controls:SettingsRow Title="登录 XML 账户" Description="使用已有用户名和密码登录，支持邮箱二次验证。">
                            <controls:SettingsRow.Editor>
                                <Button Content="登录…" Click="OpenLogin_Click" Style="{StaticResource AccentButtonStyle}"/>
                            </controls:SettingsRow.Editor>
                        </controls:SettingsRow>
                        <controls:SettingsRow Title="注册新账户" Description="填写用户名、密码和邮箱，验证邮箱后即可注册。支持 QQ / 163 / 126 等国内邮箱。">
                            <controls:SettingsRow.Editor>
                                <Button Content="注册…" Click="OpenRegister_Click"/>
                            </controls:SettingsRow.Editor>
                        </controls:SettingsRow>
                    </StackPanel>
                    <TextBlock x:Name="XmlStatusText" Style="{StaticResource CaptionTextStyle}" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="隐私" Style="{StaticResource SettingsSectionStyle}"/>
                    <controls:SettingsRow Title="参与用户体验改进计划" Description="上报启动、开游戏、异常退出这些事件（含版本号、系统信息、随机设备号）；不含账号密码、存档内容和文件路径。">
                        <controls:SettingsRow.Editor>
                            <ToggleSwitch x:Name="TelemetrySwitch" Toggled="Telemetry_Toggled" AutomationProperties.Name="参与用户体验改进计划"/>
                        </controls:SettingsRow.Editor>
                    </controls:SettingsRow>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
