<?xml version="1.0" ?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:LinxLauncher.Services" xmlns:controls="using:LinxLauncher.Controls" x:Class="LinxLauncher.Views.SettingsAccountPage" NavigationCacheMode="Required" Background="Transparent">
    <ScrollViewer Style="{StaticResource SettingsScrollStyle}">
        <Grid Style="{StaticResource PageContentStyle}" Padding="32,16,32,24">
            <StackPanel Spacing="28">
                <StackPanel>
                    <TextBlock Text="XML 账户" Style="{StaticResource SettingsGroupHeadingStyle}"/>
                    <StackPanel Spacing="4">
                        <Border Style="{StaticResource SettingsInfoCardStyle}" MinHeight="0" Background="{ThemeResource BrandSoftBrush}">
                            <Grid ColumnSpacing="18" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border services:CardAppearance.IsCard="True" Width="56" Height="56" CornerRadius="28" Background="{ThemeResource CardBackgroundBrush}"
                                        BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1" VerticalAlignment="Center">
                                    <Grid>
                                        <Image x:Name="XmlAvatarImage" Stretch="UniformToFill"
                                               Visibility="Collapsed"/>
                                        <TextBlock x:Name="XmlAvatarInitial" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="22" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource BrandBrush}"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock x:Name="XmlNameText" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{ThemeResource PrimaryTextBrush}"/>
                                    <TextBlock Text="用于联机大厅、云端存档和广场。" Style="{StaticResource CardTitleTextStyle}"/>
                                    <TextBlock Text="此账户与主导航「账户」中进入游戏的正版 / 离线身份相互独立。" Style="{StaticResource CaptionTextStyle}"/>
                                    <TextBlock x:Name="XmlStatusText" Visibility="Collapsed" Style="{StaticResource CaptionTextStyle}" AutomationProperties.LiveSetting="Polite"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel x:Name="XmlSignedOut" Spacing="4">
                            <Border Style="{StaticResource SettingsItemCardStyle}">
                                <controls:SettingsRow IconGlyph="&#xE748;" Title="登录 XML 账户" Description="使用已有用户名和密码登录，支持邮箱二次验证。">
                                    <controls:SettingsRow.Editor>
                                        <Button Content="登录" Click="OpenLogin_Click" Style="{StaticResource AccentButtonStyle}"/>
                                    </controls:SettingsRow.Editor>
                                </controls:SettingsRow>
                            </Border>
                            <Border Style="{StaticResource SettingsItemCardStyle}">
                                <controls:SettingsRow IconGlyph="&#xE8FA;" Title="注册新账户" Description="填写用户名、密码和邮箱，验证邮箱后即可注册。支持 QQ / 163 / 126 等国内邮箱。">
                                    <controls:SettingsRow.Editor>
                                        <Button Content="注册" Click="OpenRegister_Click"/>
                                    </controls:SettingsRow.Editor>
                                </controls:SettingsRow>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="XmlSignedIn" Spacing="4" Visibility="Collapsed">
                            <Border Style="{StaticResource SettingsItemCardStyle}">
                                <controls:SettingsRow IconGlyph="&#xE91B;" Title="账户头像" Description="选择图片，并同步到 XML 账户。">
                                    <controls:SettingsRow.Editor>
                                        <Button Content="换头像" Click="XmlAvatar_Click"/>
                                    </controls:SettingsRow.Editor>
                                </controls:SettingsRow>
                            </Border>
                            <Border Style="{StaticResource SettingsItemCardStyle}">
                                <controls:SettingsRow IconGlyph="&#xE713;" Title="管理账户" Description="打开账户网页，查看和管理账户信息。">
                                    <controls:SettingsRow.Editor>
                                        <Button Content="管理账户" Click="XmlManage_Click"/>
                                    </controls:SettingsRow.Editor>
                                </controls:SettingsRow>
                            </Border>
                            <Border Style="{StaticResource SettingsItemCardStyle}">
                                <controls:SettingsRow IconGlyph="&#xE8AC;" Title="退出登录" Description="退出当前 XML 账户。">
                                    <controls:SettingsRow.Editor>
                                        <Button Content="退出登录" Click="XmlLogout_Click"/>
                                    </controls:SettingsRow.Editor>
                                </controls:SettingsRow>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="隐私" Style="{StaticResource SettingsGroupHeadingStyle}"/>
                    <Border Style="{StaticResource SettingsItemCardStyle}">
                        <controls:SettingsRow IconGlyph="&#xE9D9;" Title="参与用户体验改进计划" Description="上报启动、开游戏、异常退出这些事件（含版本号、系统信息、随机设备号）；不含账号密码、存档内容和文件路径。">
                            <controls:SettingsRow.Editor>
                                <ToggleSwitch x:Name="TelemetrySwitch" Toggled="Telemetry_Toggled" AutomationProperties.Name="参与用户体验改进计划"/>
                            </controls:SettingsRow.Editor>
                        </controls:SettingsRow>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
