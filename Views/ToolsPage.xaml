<Page
    x:Class="LinxLauncher.Views.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LinxLauncher.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="40,40,40,32" MaxWidth="1000" HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="工具箱" />
            <TextBlock
                x:Name="ToolsSubtitle"
                Margin="0,6,0,0"
                Style="{StaticResource PageSubtitleTextStyle}"
                Text="内存整理、模组汉化、种子地图。" />

            <Grid Margin="0,28,0,0" ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 内存整理 -->
                <controls:FeatureCard
                    x:Name="MemCard"
                    Grid.Row="0"
                    Grid.Column="0"
                    IconTemplate="{StaticResource IconCardTask}">
                    <controls:FeatureCard.Actions>
                        <Button
                            Click="MemClean_Click"
                            Content="整理"
                            Style="{StaticResource CardActionButtonStyle}" />
                    </controls:FeatureCard.Actions>
                </controls:FeatureCard>

                <!-- 模组汉化 -->
                <controls:FeatureCard
                    x:Name="TranslateCard"
                    Grid.Row="0"
                    Grid.Column="1"
                    IconTemplate="{StaticResource IconCardLibrary}">
                    <controls:FeatureCard.Actions>
                        <Button
                            Click="TranslatePick_Click"
                            Content="选模组"
                            Style="{StaticResource CardActionButtonStyle}" />
                    </controls:FeatureCard.Actions>
                </controls:FeatureCard>

                <!-- 种子地图 -->
                <controls:FeatureCard
                    x:Name="SeedCard"
                    Grid.Row="1"
                    Grid.Column="0"
                    IconTemplate="{StaticResource IconCardGame}">
                    <controls:FeatureCard.Actions>
                        <Button
                            Click="SeedOpen_Click"
                            Content="解析"
                            Style="{StaticResource CardActionButtonStyle}" />
                    </controls:FeatureCard.Actions>
                </controls:FeatureCard>

                <!-- 缓存清理 -->
                <controls:FeatureCard
                    x:Name="CacheCard"
                    Grid.Row="1"
                    Grid.Column="1"
                    IconTemplate="{StaticResource IconCardDownload}">
                    <controls:FeatureCard.Actions>
                        <Button
                            Click="CacheClean_Click"
                            Content="清理"
                            Style="{StaticResource CardActionButtonStyle}" />
                    </controls:FeatureCard.Actions>
                </controls:FeatureCard>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
