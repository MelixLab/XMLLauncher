<Page
    x:Class="LinxLauncher.Views.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LinxLauncher.Controls">

    <ScrollViewer Style="{StaticResource PageScrollStyle}">
        <Grid x:Name="PageContent" Style="{StaticResource PageContentStyle}" MaxWidth="1040">
            <StackPanel>

                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="工具箱" />
                <TextBlock
                    x:Name="ToolsSubtitle"
                    Margin="0,6,0,0"
                    Style="{StaticResource PageSubtitleTextStyle}"
                    Text="内存整理、模组汉化、种子地图。" />

                <controls:AdaptiveWrapPanel Margin="0,28,0,0" ItemMinWidth="300" MaxColumns="2" Spacing="8"
                                            PointerMoved="ToolCards_PointerMoved" PointerExited="ToolCards_PointerExited">

                    <!-- 内存整理 -->
                    <controls:FeatureCard
                        x:Name="MemCard"
                        IconTemplate="{StaticResource IconCardTask}">
                        <controls:FeatureCard.Actions>
                            <Button
                                Click="MemClean_Click"
                                Content="整理"
                                Style="{StaticResource CardActionButtonStyle}" />
                        </controls:FeatureCard.Actions>
                    </controls:FeatureCard>

                    <!-- 模组汉化 -->
                    <controls:FeatureCard
                        x:Name="TranslateCard"
                        IconTemplate="{StaticResource IconCardLibrary}">
                        <controls:FeatureCard.Actions>
                            <Button
                                Click="TranslatePick_Click"
                                Content="选模组"
                                Style="{StaticResource CardActionButtonStyle}" />
                        </controls:FeatureCard.Actions>
                    </controls:FeatureCard>

                    <!-- 种子地图 -->
                    <controls:FeatureCard
                        x:Name="SeedCard"
                        IconTemplate="{StaticResource IconCardGame}">
                        <controls:FeatureCard.Actions>
                            <Button
                                Click="SeedOpen_Click"
                                Content="解析"
                                Style="{StaticResource CardActionButtonStyle}" />
                        </controls:FeatureCard.Actions>
                    </controls:FeatureCard>

                    <!-- 缓存清理 -->
                    <controls:FeatureCard
                        x:Name="CacheCard"
                        IconTemplate="{StaticResource IconCardDownload}">
                        <controls:FeatureCard.Actions>
                            <Button
                                Click="CacheClean_Click"
                                Content="清理"
                                Style="{StaticResource CardActionButtonStyle}" />
                        </controls:FeatureCard.Actions>
                    </controls:FeatureCard>
                </controls:AdaptiveWrapPanel>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
