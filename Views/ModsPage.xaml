<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LinxLauncher.Views.ModsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:LinxLauncher.Services"
    xmlns:controls="using:LinxLauncher.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource PageLayerBackgroundBrush}"
    mc:Ignorable="d">

    <Grid x:Name="PageContent" SizeChanged="PageContent_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="ModHeader" Spacing="10" MaxWidth="1136" Margin="32,28,32,0">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Mod 下载" />
            <TextBlock
                Style="{StaticResource PageSubtitleTextStyle}"
                Text="从 Modrinth 搜索 Mod，按加载器和游戏版本筛选，直接装进选中的实例。"
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid x:Name="SearchRow" Grid.Row="1" Margin="32,20,32,0" MaxWidth="1136" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="SearchBox"
                AutomationProperties.Name="搜索 Mod"
                KeyDown="SearchBox_KeyDown"
                PlaceholderText="搜索 Mod，例如 sodium、机械动力…" />
            <Button
                Grid.Column="1"
                MinWidth="72"
                Click="Search_Click"
                Content="搜索" />
        </Grid>

        <controls:AdaptiveWrapPanel x:Name="FilterHost" Grid.Row="2" Margin="32,8,32,0" MaxWidth="1136" ItemMinWidth="180" MaxColumns="3" Spacing="8">
            <ComboBox
                x:Name="LoaderBox"
                HorizontalAlignment="Stretch"
                Header="加载器"
                SelectedIndex="0"
                SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="全部加载器" />
                <ComboBoxItem Content="Fabric" />
                <ComboBoxItem Content="Forge" />
                <ComboBoxItem Content="NeoForge" />
                <ComboBoxItem Content="Quilt" />
            </ComboBox>
            <ComboBox
                x:Name="TargetBox"
                HorizontalAlignment="Stretch"
                DisplayMemberPath="Id"
                Header="目标实例"
                PlaceholderText="装到哪个版本"
                SelectionChanged="Target_Changed" />
            <ComboBox
                x:Name="SortBox"
                HorizontalAlignment="Stretch"
                Header="排序"
                SelectedIndex="1"
                SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="相关度" />
                <ComboBoxItem Content="下载量" />
                <ComboBoxItem Content="最近更新" />
                <ComboBoxItem Content="最新发布" />
            </ComboBox>
        </controls:AdaptiveWrapPanel>

            <Grid Grid.Row="3" Margin="0,12,0,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- 卡片背景限制在内容宽度，原生列表与滚动条占满页面宽度。 -->
                <Border services:CardAppearance.IsCard="True" x:Name="ResultBackground" Grid.RowSpan="3" MaxWidth="1136" Margin="32,0"
                        Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource DividerBrush}"
                        BorderThickness="1" CornerRadius="8" IsHitTestVisible="False" />
                <TextBlock
                    x:Name="StatusText"
                    Margin="44,12,44,8" MaxWidth="1112"
                    FontSize="12.5"
                    Foreground="{ThemeResource SecondaryTextBrush}"
                    Text="Modrinth · 搜索结果"
                    TextWrapping="Wrap" />

                <ListView
                    x:Name="ResultList"
                    Grid.Row="1"
                    Padding="44,0,44,12"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    SelectionMode="None"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.HorizontalScrollMode="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MaxWidth" Value="1112" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="10" HorizontalAlignment="Stretch" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    services:CardAppearance.IsCard="True"
                                    Width="40"
                                    Height="40"
                                    VerticalAlignment="Top"
                                    Background="{ThemeResource BrandSoftBrush}"
                                    CornerRadius="6">
                                    <Image Source="{Binding IconUrl}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock
                                        FontSize="15"
                                        Foreground="{ThemeResource PrimaryTextBrush}"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        MaxLines="2"
                                        FontSize="12.5"
                                        Foreground="{ThemeResource SecondaryTextBrush}"
                                        Text="{Binding Description}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontSize="11.5"
                                        Foreground="{ThemeResource TertiaryTextBrush}"
                                        Text="{Binding DownloadsText}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Click="Install_Click"
                                    Content="安装" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <ScrollViewer
                    x:Name="ResultState"
                    Grid.Row="1"
                    HorizontalContentAlignment="Stretch"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <StackPanel MaxWidth="480" Margin="16,24" HorizontalAlignment="Center" Spacing="12">
                        <ProgressRing x:Name="LoadingRing" Width="32" Height="32" IsActive="False" Visibility="Collapsed" />
                        <FontIcon
                            x:Name="StateIcon"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="32"
                            Foreground="{ThemeResource SecondaryTextBrush}"
                            Glyph="&#xE721;" />
                        <TextBlock
                            x:Name="StateTitle"
                            HorizontalAlignment="Center"
                            FontSize="18"
                            Foreground="{ThemeResource PrimaryTextBrush}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="StateMessage"
                            Foreground="{ThemeResource SecondaryTextBrush}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="RetryButton"
                            HorizontalAlignment="Center"
                            Click="Retry_Click"
                            Content="重新搜索"
                            Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="ResultFooter" Grid.Row="2" Margin="44,10,44,12" MaxWidth="1112" ColumnSpacing="8" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressRing
                        x:Name="MoreLoadingRing"
                        Width="16"
                        Height="16"
                        IsActive="False"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="FootHint"
                        Grid.Column="1"
                        MaxLines="3"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource SecondaryTextBrush}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="MoreButton"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Click="More_Click"
                        Content="加载更多"
                        Visibility="Collapsed" />
                </Grid>
            </Grid>
    </Grid>
</Page>
