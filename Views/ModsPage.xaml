<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LinxLauncher.Views.ModsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource PageLayerBackgroundBrush}"
    mc:Ignorable="d">

    <Grid Padding="40,36,40,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Spacing="10">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Mod 下载" />
            <TextBlock
                Style="{StaticResource PageSubtitleTextStyle}"
                Text="从 Modrinth 搜索 Mod，按加载器和游戏版本筛选，直接装进选中的实例。" />
        </StackPanel>

        <!-- 搜索行：搜索框占满整行，不再被下拉框挤扁 -->
        <Grid Grid.Row="1" Margin="0,20,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="SearchBox"
                KeyDown="SearchBox_KeyDown"
                PlaceholderText="搜索 Mod，例如 sodium、机械动力…" />

            <Button
                Grid.Column="1"
                MinWidth="72"
                Click="Search_Click"
                Content="搜索" />
        </Grid>

        <!-- 筛选行 -->
        <Grid Grid.Row="2" Margin="0,8,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ComboBox
                x:Name="LoaderBox"
                Width="132"
                SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="全部加载器" />
                <ComboBoxItem Content="Fabric" />
                <ComboBoxItem Content="Forge" />
                <ComboBoxItem Content="NeoForge" />
                <ComboBoxItem Content="Quilt" />
            </ComboBox>

            <ComboBox
                x:Name="TargetBox"
                Grid.Column="1"
                Width="176"
                DisplayMemberPath="Id"
                PlaceholderText="装到哪个版本"
                SelectionChanged="Target_Changed" />

            <ComboBox
                x:Name="SortBox"
                Grid.Column="2"
                Width="120"
                SelectedIndex="1"
                SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="相关度" />
                <ComboBoxItem Content="下载量" />
                <ComboBoxItem Content="最近更新" />
                <ComboBoxItem Content="最新发布" />
            </ComboBox>

            <StackPanel
                Grid.Column="3"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <ProgressRing
                    x:Name="LoadingRing"
                    Width="16"
                    Height="16"
                    IsActive="False"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="StatusText"
                    VerticalAlignment="Center"
                    FontSize="12.5"
                    Foreground="{ThemeResource SecondaryTextBrush}"
                    Text="输入关键词搜索，或直接看下载量最高的 Mod。" />
            </StackPanel>
        </Grid>

        <!-- 结果 -->
        <Border
            Grid.Row="3"
            Margin="0,12,0,0"
            Background="{ThemeResource CardBackgroundBrush}"
            BorderBrush="{ThemeResource DividerBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <ListView
                x:Name="ResultList"
                Padding="6"
                SelectionMode="None"
                ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="40"
                                Height="40"
                                VerticalAlignment="Top"
                                Background="{ThemeResource BrandSoftBrush}"
                                CornerRadius="6">
                                <Image Source="{Binding IconUrl}" Stretch="UniformToFill" />
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock
                                    FontSize="15"
                                    Foreground="{ThemeResource PrimaryTextBrush}"
                                    Text="{Binding Title}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    MaxLines="2"
                                    FontSize="12.5"
                                    Foreground="{ThemeResource SecondaryTextBrush}"
                                    Text="{Binding Description}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    FontSize="11.5"
                                    Foreground="{ThemeResource TertiaryTextBrush}"
                                    Text="{Binding DownloadsText}" />
                            </StackPanel>

                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="Install_Click"
                                Content="安装" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- 加载更多 -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <TextBlock
                x:Name="FootHint"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TertiaryTextBrush}"
                Text="" />
            <Button
                x:Name="MoreButton"
                HorizontalAlignment="Right"
                Click="More_Click"
                Content="加载更多"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page>
