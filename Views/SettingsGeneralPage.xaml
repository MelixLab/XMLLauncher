<?xml version="1.0" ?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:LinxLauncher.Controls" x:Class="LinxLauncher.Views.SettingsGeneralPage" NavigationCacheMode="Required" Background="Transparent">
    <ScrollViewer Style="{StaticResource SettingsScrollStyle}">
        <Grid x:Name="Columns" ColumnSpacing="16" RowSpacing="16" SizeChanged="Columns_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel x:Name="LeftColumn" Spacing="16">
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="游戏目录" Style="{StaticResource SettingsSectionStyle}"/>
                        <TextBlock Text="所有版本、依赖库与资源文件都保存在这里。" Style="{StaticResource CaptionTextStyle}"/>
                        <TextBox x:Name="GameDirBox" Header="当前路径" IsReadOnly="True" TextWrapping="Wrap"/>
                        <Button Content="浏览文件夹…" Click="Browse_Click"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="从其他启动器导入" Style="{StaticResource SettingsSectionStyle}"/>
                        <TextBlock Text="识别 PCL2 / HMCL / 官方启动器的 .minecraft 目录，复制版本、存档和模组，不覆盖已有文件。" Style="{StaticResource CaptionTextStyle}"/>
                        <StackPanel x:Name="ImportHost" Spacing="8"/>
                        <controls:AdaptiveWrapPanel Spacing="8">
                            <Button Content="重新检测" Click="RefreshImport_Click"/>
                            <Button Content="选择其他文件夹…" Click="ChooseImportDir_Click"/>
                        </controls:AdaptiveWrapPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="下载设置" Style="{StaticResource SettingsSectionStyle}"/>
                        <controls:SettingsRow Title="使用 BMCLAPI 镜像" Description="关闭后直连 Mojang 官方源，国内通常较慢。">
                            <controls:SettingsRow.Editor>
                                <ToggleSwitch x:Name="MirrorSwitch" Toggled="Mirror_Toggled" AutomationProperties.Name="使用 BMCLAPI 镜像"/>
                            </controls:SettingsRow.Editor>
                        </controls:SettingsRow>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="并发下载线程" Style="{StaticResource CaptionTextStyle}"/>
                            <TextBlock Grid.Column="1" x:Name="ThreadValue" HorizontalAlignment="Right" Style="{StaticResource MetricValueTextStyle}"/>
                        </Grid>
                        <Slider x:Name="ThreadSlider" Minimum="2" Maximum="24" StepFrequency="1" ValueChanged="Thread_Changed" AutomationProperties.Name="并发下载线程"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel x:Name="RightColumn" Grid.Row="1" Spacing="16">
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="启动配置" Style="{StaticResource SettingsSectionStyle}"/>
                        <StackPanel Spacing="8">
                            <TextBox x:Name="PlayerNameBox" Header="离线玩家名" MaxLength="16" TextChanged="PlayerName_Changed"/>
                            <Button x:Name="PlayerNameSaveButton" Content="保存" HorizontalAlignment="Right" IsEnabled="False"
                                    Click="SavePlayerName_Click" Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="保存离线玩家名"/>
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <ComboBox x:Name="JavaBox" Header="Java 运行时" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" SelectionChanged="Java_Changed"/>
                            <Button Content="重新检测 Java" Click="RescanJava_Click"/>
                        </StackPanel>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="内存分配" Style="{StaticResource CaptionTextStyle}"/>
                            <TextBlock Grid.Column="1" x:Name="MemoryValue" HorizontalAlignment="Right" Style="{StaticResource MetricValueTextStyle}"/>
                        </Grid>
                        <Slider x:Name="MemorySlider" Minimum="1024" Maximum="16384" StepFrequency="512" ValueChanged="Memory_Changed" AutomationProperties.Name="内存分配 MB"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="游戏窗口" Style="{StaticResource SettingsSectionStyle}"/>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <NumberBox x:Name="WidthBox" Header="宽度（像素）" Minimum="320" Maximum="7680" SpinButtonPlacementMode="Compact" ValueChanged="WindowSize_Changed"/>
                            <NumberBox x:Name="HeightBox" Grid.Column="1" Header="高度（像素）" Minimum="240" Maximum="4320" SpinButtonPlacementMode="Compact" ValueChanged="WindowSize_Changed"/>
                        </Grid>
                        <controls:SettingsRow Title="全屏启动" Description="进入游戏时直接使用全屏模式。">
                            <controls:SettingsRow.Editor>
                                <ToggleSwitch x:Name="FullscreenSwitch" Toggled="Fullscreen_Toggled" AutomationProperties.Name="全屏启动"/>
                            </controls:SettingsRow.Editor>
                        </controls:SettingsRow>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
