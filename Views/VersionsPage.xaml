<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LinxLauncher.Views.VersionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:LinxLauncher.Models"
    Background="Transparent"
    mc:Ignorable="d">

    <!-- 整页都能接 .jar：之前 AllowDrop 只挂在 Mod 面板上，
         而那个面板默认是 Collapsed，往页面别处拖一律没反应 -->
    <Grid Padding="40,40,40,32"
          AllowDrop="True"
          DragOver="Mods_DragOver"
          Drop="Mods_Drop">

        <!-- ================================================================
             视图一：版本列表（照「保护历史记录」：行内无底色，悬停才铺灰）
             ================================================================ -->
        <Grid x:Name="ListViewHost">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="版本库" />
                    <TextBlock
                        Margin="0,11,0,0"
                        Style="{StaticResource PageSubtitleTextStyle}"
                        Text="挑一个版本，进去再选模组加载器。全部走国内镜像下载。" />
                </StackPanel>

                <StackPanel
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="FilterButton"
                        Content="全部"
                        Style="{StaticResource RecordActionButtonStyle}">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuFlyoutItem Click="Filter_Click" Tag="0" Text="全部" />
                                <MenuFlyoutItem Click="Filter_Click" Tag="1" Text="正式版" />
                                <MenuFlyoutItem Click="Filter_Click" Tag="2" Text="快照" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <TextBox
                        x:Name="SearchBox"
                        Width="200"
                        Height="32"
                        PlaceholderText="搜索版本号"
                        TextChanged="Search_Changed" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,20,0,0">
                <ListView
                    x:Name="VersionList"
                    SelectionChanged="Version_SelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="CornerRadius" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:VersionSummary">
                            <Grid Padding="16,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="232" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource IconFontFamily}"
                                    FontSize="20"
                                    Foreground="{ThemeResource SecondaryTextBrush}"
                                    Glyph="&#xE7FC;" />

                                <StackPanel
                                    Grid.Column="1"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <TextBlock
                                            Style="{StaticResource CardTitleTextStyle}"
                                            Text="{x:Bind Id}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                        <Ellipse
                                            Width="6"
                                            Height="6"
                                            VerticalAlignment="Center"
                                            Fill="{ThemeResource BrandBrush}"
                                            Visibility="{Binding Installed, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        Style="{StaticResource RecordDateTextStyle}"
                                        Text="{x:Bind TypeLabel}" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="2"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource RecordDateTextStyle}"
                                    Text="{x:Bind DateText}" />

                                <FontIcon
                                    Grid.Column="3"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource IconFontFamily}"
                                    FontSize="11"
                                    Foreground="{ThemeResource SecondaryTextBrush}"
                                    Glyph="&#xE76C;" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <ProgressRing
                    x:Name="LoadingRing"
                    Width="28"
                    Height="28"
                    IsActive="True" />

                <StackPanel
                    x:Name="ErrorPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="ErrorText"
                        MaxWidth="280"
                        Style="{StaticResource CaptionTextStyle}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Button
                        HorizontalAlignment="Center"
                        Click="Retry_Click"
                        Content="重试" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ================================================================
             视图二：详情 —— 版本信息 + 模组加载器九宫格
             ================================================================ -->
        <Grid x:Name="DetailHost" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 返回 + 标题 -->
            <StackPanel Grid.Row="0">
                <Button
                    Padding="0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="Back_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="12"
                            Foreground="{ThemeResource LinkTextBrush}"
                            Glyph="&#xE72B;" />
                        <TextBlock
                            FontSize="13"
                            Foreground="{ThemeResource LinkTextBrush}"
                            Text="返回版本列表" />
                    </StackPanel>
                </Button>

                <Grid Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock
                            x:Name="DetailId"
                            Style="{StaticResource PageTitleTextStyle}"
                            Text="—" />
                        <TextBlock
                            x:Name="DetailMeta"
                            Margin="0,9,0,0"
                            Style="{StaticResource PageSubtitleTextStyle}"
                            Text="" />
                    </StackPanel>

                    <Border
                        x:Name="InstalledBadge"
                        Padding="8,3"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="{ThemeResource BrandSoftBrush}"
                        CornerRadius="0"
                        Visibility="Collapsed">
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource LinkTextBrush}"
                            Text="已安装" />
                    </Border>
                </Grid>
            </StackPanel>

            <ScrollViewer
                Grid.Row="1"
                Margin="0,24,0,0"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
        HorizontalContentAlignment="Stretch"
                VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock
                        Style="{StaticResource SectionTitleTextStyle}"
                        Text="选择模组加载器" />
                    <TextBlock
                        Margin="0,6,0,16"
                        Style="{StaticResource CaptionTextStyle}"
                        Text="原版只装游戏本体；装了加载器才能用模组。" />

                    <!-- 九宫格：5 张加载器卡片，与主页卡片同一套观感 -->
                    <Grid ColumnSpacing="8" RowSpacing="8" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="232" />
                            <ColumnDefinition Width="232" />
                            <ColumnDefinition Width="232" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="132" />
                            <RowDefinition Height="132" />
                        </Grid.RowDefinitions>

                        <ToggleButton
                            x:Name="CardVanilla"
                            AutomationProperties.Name="原版"
                            Grid.Row="0"
                            Grid.Column="0"
                            Tag="vanilla"
                            Style="{StaticResource LoaderCardStyle}"
                            Click="LoaderCard_Click">
                            <StackPanel>
                                <Image Width="42" Height="42" HorizontalAlignment="Left" Source="ms-appx:///Assets/Blocks/vanilla.png" />
                                <TextBlock Margin="0,12,0,0" Style="{StaticResource CardTitleTextStyle}" Text="原版" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource CardStatusTextStyle}" Text="纯净游戏本体" />
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton
                            x:Name="CardFabric"
                            AutomationProperties.Name="Fabric"
                            Grid.Row="0"
                            Grid.Column="1"
                            Tag="fabric"
                            Style="{StaticResource LoaderCardStyle}"
                            Click="LoaderCard_Click">
                            <StackPanel>
                                <Image Width="42" Height="42" HorizontalAlignment="Left" Source="ms-appx:///Assets/Blocks/fabric.png" />
                                <TextBlock Margin="0,12,0,0" Style="{StaticResource CardTitleTextStyle}" Text="Fabric" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource CardStatusTextStyle}" Text="轻量、跟进快" />
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton
                            x:Name="CardForge"
                            AutomationProperties.Name="Forge"
                            Grid.Row="0"
                            Grid.Column="2"
                            Tag="forge"
                            Style="{StaticResource LoaderCardStyle}"
                            Click="LoaderCard_Click">
                            <StackPanel>
                                <Image Width="42" Height="42" HorizontalAlignment="Left" Source="ms-appx:///Assets/Blocks/forge.png" />
                                <TextBlock Margin="0,12,0,0" Style="{StaticResource CardTitleTextStyle}" Text="Forge" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource CardStatusTextStyle}" Text="老牌、模组最多" />
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton
                            x:Name="CardNeoForge"
                            AutomationProperties.Name="NeoForge"
                            Grid.Row="1"
                            Grid.Column="0"
                            Tag="neoforge"
                            Style="{StaticResource LoaderCardStyle}"
                            Click="LoaderCard_Click">
                            <StackPanel>
                                <Image Width="42" Height="42" HorizontalAlignment="Left" Source="ms-appx:///Assets/Blocks/neoforge.png" />
                                <TextBlock Margin="0,12,0,0" Style="{StaticResource CardTitleTextStyle}" Text="NeoForge" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource CardStatusTextStyle}" Text="社区接手的新分支" />
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton
                            x:Name="CardQuilt"
                            AutomationProperties.Name="Quilt"
                            Grid.Row="1"
                            Grid.Column="1"
                            Tag="quilt"
                            Style="{StaticResource LoaderCardStyle}"
                            Click="LoaderCard_Click">
                            <StackPanel>
                                <Image Width="42" Height="42" HorizontalAlignment="Left" Source="ms-appx:///Assets/Blocks/quilt.png" />
                                <TextBlock Margin="0,12,0,0" Style="{StaticResource CardTitleTextStyle}" Text="Quilt" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource CardStatusTextStyle}" Text="Fabric 的进阶分支" />
                            </StackPanel>
                        </ToggleButton>
                    </Grid>

                    <!-- 加载器版本 -->
                    <StackPanel
                        x:Name="LoaderVersionPanel"
                        Margin="0,20,0,0"
                        Spacing="8"
                        Visibility="Collapsed">
                        <StackPanel.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.22" />
                        </StackPanel.OpacityTransition>
                        <StackPanel.TranslationTransition>
                            <Vector3Transition Duration="0:0:0.28" />
                        </StackPanel.TranslationTransition>
                        <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="加载器版本" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="232" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="LoaderVersionBox"
                                Height="32"
                                SelectionChanged="LoaderVersion_Changed" />
                            <ProgressRing
                                x:Name="LoaderRing"
                                Grid.Column="1"
                                Width="18"
                                Height="18"
                                VerticalAlignment="Center"
                                Visibility="Collapsed" />
                        </Grid>
                        <TextBlock
                            x:Name="LoaderHint"
                            Style="{StaticResource CaptionTextStyle}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </StackPanel>

                    <!-- ================= 实例设置（只对已安装的版本显示） ================= -->
                    <TextBlock
                        x:Name="InstanceSectionTitle"
                        Margin="0,28,0,10"
                        Style="{StaticResource SectionTitleTextStyle}"
                        Text="启动设置"
                        Visibility="Collapsed" />

                    <Border
                        x:Name="InstancePanel"
                        Padding="20,16"
                        Background="{ThemeResource CardBackgroundBrush}"
                        BorderBrush="{ThemeResource DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="Collapsed">
                        <StackPanel Spacing="16">

                            <Grid>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource BodyTextStyle}" Text="最大内存 (MB)" />
                                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="这个实例启动时分配的堆大小。" />
                                </StackPanel>
                                <NumberBox
                                    x:Name="MemoryBox"
                                    Width="140"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Maximum="65536"
                                    Minimum="1024"
                                    SpinButtonPlacementMode="Compact"
                                    ValueChanged="Number_Changed" />
                            </Grid>

                            <Grid>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource BodyTextStyle}" Text="窗口分辨率" />
                                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="只影响这个实例；全屏时忽略。" />
                                </StackPanel>
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <NumberBox
                                        x:Name="WidthBox"
                                        Width="110"
                                        Maximum="7680"
                                        Minimum="320"
                                        SpinButtonPlacementMode="Compact"
                                        ValueChanged="Number_Changed" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CaptionTextStyle}"
                                        Text="×" />
                                    <NumberBox
                                        x:Name="HeightBox"
                                        Width="110"
                                        Maximum="4320"
                                        Minimum="240"
                                        SpinButtonPlacementMode="Compact"
                                        ValueChanged="Number_Changed" />
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource BodyTextStyle}" Text="全屏启动" />
                                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="进游戏直接全屏。" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="FullscreenSwitch"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Toggled="Toggle_Changed" />
                            </Grid>

                            <Grid>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource BodyTextStyle}" Text="版本隔离" />
                                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="开启后该版本的模组与存档独立存放。" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="IsolatedSwitch"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Toggled="Toggle_Changed" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 实例信息 -->
                    <TextBlock
                        x:Name="InstanceInfoTitle"
                        Margin="0,24,0,10"
                        Style="{StaticResource SectionTitleTextStyle}"
                        Text="实例"
                        Visibility="Collapsed" />

                    <Grid x:Name="InstanceInfoPanel" ColumnSpacing="8" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Padding="16,14"
                            Background="{ThemeResource CardBackgroundBrush}"
                            BorderBrush="{ThemeResource DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="5">
                                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="占用空间" />
                                <TextBlock x:Name="SizeValue" Style="{StaticResource MetricValueTextStyle}" Text="—" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="1"
                            Padding="16,14"
                            Background="{ThemeResource CardBackgroundBrush}"
                            BorderBrush="{ThemeResource DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="5">
                                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="Mod" />
                                <TextBlock x:Name="ModCountValue" Style="{StaticResource MetricValueTextStyle}" Text="—" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="2"
                            Padding="16,14"
                            Background="{ThemeResource CardBackgroundBrush}"
                            BorderBrush="{ThemeResource DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="5">
                                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="存档" />
                                <TextBlock x:Name="SavesValue" Style="{StaticResource MetricValueTextStyle}" Text="—" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="OpenModsButton"
                            Margin="0,12,0,0"
                            Click="OpenMods_Click"
                            Content="打开 mods 文件夹"
                            Visibility="Collapsed" />

                        <Button
                            x:Name="CheckModUpdateButton"
                            Margin="0,12,0,0"
                            Click="CheckModUpdate_Click"
                            Content="检查 Mod 更新"
                            Visibility="Collapsed" />
                    </StackPanel>

                    <Button
                        x:Name="RepairButton"
                        Margin="0,8,0,0"
                        Click="Repair_Click"
                        Content="校验并修复文件"
                        Visibility="Collapsed" />

                    <Button
                        x:Name="DeleteButton"
                        Margin="0,8,0,0"
                        Click="Delete_Click"
                        Content="删除这个版本"
                        Visibility="Collapsed" />

                    <!-- ================= Mod 管理 ================= -->
                    <TextBlock
                        x:Name="ModSectionTitle"
                        Margin="0,24,0,10"
                        Style="{StaticResource SectionTitleTextStyle}"
                        Text="Mod 管理"
                        Visibility="Collapsed" />

                    <Border
                        x:Name="ModPanel"
                        Padding="16,14"
                        AllowDrop="True"
                        Background="{ThemeResource CardBackgroundBrush}"
                        BorderBrush="{ThemeResource DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        DragOver="Mods_DragOver"
                        Drop="Mods_Drop"
                        Visibility="Collapsed">
                        <StackPanel Spacing="10">
                            <TextBlock
                                Style="{StaticResource CaptionTextStyle}"
                                Text="把 .jar 拖到这里即可安装；也可以在这里禁用或卸载。" />

                            <TextBlock
                                x:Name="ModEmptyHint"
                                Style="{StaticResource BodyTextStyle}"
                                Text="还没有安装任何 Mod。" />

                            <ListView
                                x:Name="ModList"
                                SelectionMode="None"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollMode="Disabled">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="CornerRadius" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid
                                            Padding="0,8"
                                            ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <FontIcon
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                FontSize="15"
                                                Foreground="{ThemeResource SecondaryTextBrush}"
                                                Glyph="&#xE7B8;" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock
                                                    Style="{StaticResource CardTitleTextStyle}"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    Style="{StaticResource CardStatusTextStyle}"
                                                    Text="{Binding Info}" />
                                            </StackPanel>

                                            <Button
                                                Grid.Column="2"
                                                Height="28"
                                                Padding="12,0"
                                                VerticalAlignment="Center"
                                                Click="ModToggle_Click"
                                                Content="{Binding ToggleText}"
                                                FontSize="12"
                                                Tag="{Binding}" />

                                            <Button
                                                Grid.Column="3"
                                                Height="28"
                                                Padding="12,0"
                                                VerticalAlignment="Center"
                                                Click="ModDelete_Click"
                                                Content="卸载"
                                                FontSize="12"
                                                Tag="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <InfoBar
                        x:Name="WarnBar"
                        Margin="0,16,0,0"
                        IsClosable="False"
                        IsOpen="False"
                        Severity="Warning" />

                    <!-- 安装动作 -->
                    <Border
                        Margin="0,24,0,0"
                        Padding="20,18"
                        Background="{ThemeResource ThreatCardBackgroundBrush}"
                        CornerRadius="8">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="InstallSummary"
                                    Style="{StaticResource BodyTextStyle}"
                                    Text="将安装" />
                                <TextBlock
                                    x:Name="InstallHint"
                                    Margin="0,3,0,0"
                                    Style="{StaticResource CardStatusTextStyle}"
                                    Text="客户端 / 依赖库 / 资源文件" />
                            </StackPanel>

                            <StackPanel
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="10">
                                <Button
                                    Click="Back_Click"
                                    Content="返回"
                                    CornerRadius="4"
                                    Height="34"
                                    MinWidth="88" />
                                <Button
                                    x:Name="InstallButton"
                                    MinWidth="112"
                                    Height="34"
                                    Click="Install_Click"
                                    Content="下载并安装"
                                    Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
