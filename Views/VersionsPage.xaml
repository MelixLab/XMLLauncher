<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LinxLauncher.Views.VersionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:LinxLauncher.Models"
    xmlns:controls="using:LinxLauncher.Controls"
    Background="Transparent"
    mc:Ignorable="d">

    <!-- 整页都能接 .jar：之前 AllowDrop 只挂在 Mod 面板上，
         而那个面板默认是 Collapsed，往页面别处拖一律没反应 -->
    <Grid x:Name="PageLayout" Style="{StaticResource PageContentStyle}"
          SizeChanged="PageLayout_SizeChanged"
          AllowDrop="True"
          DragOver="Mods_DragOver"
          Drop="Mods_Drop">

        <!-- ================================================================
             视图一：版本列表（照「保护历史记录」：行内无底色，悬停才铺灰）
             ================================================================ -->
        <Grid x:Name="ListViewHost">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="24" RowSpacing="16" SizeChanged="ListHeader_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel x:Name="ListHeading">
                    <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="版本库" />
                    <TextBlock
                        Margin="0,11,0,0"
                        Style="{StaticResource PageSubtitleTextStyle}"
                        Text="挑一个版本，进去再选模组加载器。全部走国内镜像下载。"
                        TextWrapping="Wrap" />
                    <TextBlock x:Name="InstalledModeHint" Margin="0,8,0,0"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="正在显示本地已安装实例；选择筛选项可浏览在线版本。"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>

                <Grid x:Name="ListTools" Grid.Column="1"
                    VerticalAlignment="Bottom"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="FilterBox" MinWidth="112" MinHeight="32"
                              PlaceholderText="版本类型" AutomationProperties.Name="版本类型筛选"
                              SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="全部" />
                        <ComboBoxItem Content="正式版" />
                        <ComboBoxItem Content="快照" />
                    </ComboBox>
                    <TextBox
                        x:Name="SearchBox"
                        Grid.Column="1"
                        MinHeight="32"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="搜索版本号"
                        PlaceholderText="搜索版本号"
                        TextChanged="Search_Changed" />
                </Grid>
            </Grid>

            <Grid Grid.Row="1" Margin="0,20,0,0">
                <ListView
                    x:Name="VersionList"
                    IsItemClickEnabled="True"
                    ItemClick="Version_ItemClick"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="CornerRadius" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:VersionSummary">
                            <Grid Padding="16,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource IconFontFamily}"
                                    FontSize="20"
                                    Foreground="{ThemeResource SecondaryTextBrush}"
                                    Glyph="&#xE7FC;" />

                                <StackPanel
                                    Grid.Column="1"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center">
                                    <Grid ColumnSpacing="7" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Style="{StaticResource CardTitleTextStyle}"
                                            Text="{x:Bind Id}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                        <Ellipse
                                            Grid.Column="1"
                                            Width="6"
                                            Height="6"
                                            VerticalAlignment="Center"
                                            Fill="{ThemeResource BrandBrush}"
                                            Visibility="{x:Bind Installed, Mode=OneTime, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
                                    </Grid>
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        Style="{StaticResource RecordDateTextStyle}"
                                        Text="{x:Bind TypeLabel}" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="2"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource RecordDateTextStyle}"
                                    Text="{x:Bind DateText}" />

                                <FontIcon
                                    Grid.Column="3"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource IconFontFamily}"
                                    FontSize="11"
                                    Foreground="{ThemeResource SecondaryTextBrush}"
                                    Glyph="&#xE76C;" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <ProgressRing
                    x:Name="LoadingRing"
                    Width="28"
                    Height="28"
                    IsActive="False" Visibility="Collapsed" />

                <StackPanel x:Name="EmptyPanel" Spacing="8" MaxWidth="360" Margin="16"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE721;"
                              FontSize="28" Foreground="{ThemeResource SecondaryTextBrush}" />
                    <TextBlock x:Name="EmptyText" Style="{StaticResource BodyTextStyle}"
                               TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="试试其他版本类型或搜索关键词。"
                               TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel
                    x:Name="ErrorPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="ErrorText"
                        MaxWidth="280"
                        Style="{StaticResource CaptionTextStyle}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Button
                        HorizontalAlignment="Center"
                        Click="Retry_Click"
                        Content="重试" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ================================================================
             视图二：详情 —— 版本信息 + 模组加载器九宫格
             ================================================================ -->
        <Grid x:Name="DetailHost" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 返回 + 标题 -->
            <StackPanel Grid.Row="0">
                <Button
                    x:Name="BackButton"
                    AutomationProperties.Name="返回版本列表"
                    Style="{StaticResource PageBackButtonStyle}"
                    Click="Back_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="14"
                            VerticalAlignment="Center"
                            Glyph="&#xE72B;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="返回版本列表" />
                    </StackPanel>
                </Button>

                <Grid Margin="0,14,0,0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock
                            x:Name="DetailId"
                            Style="{StaticResource PageTitleTextStyle}"
                            Text="—" TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="DetailMeta"
                            Margin="0,9,0,0"
                            Style="{StaticResource PageSubtitleTextStyle}"
                            Text="" TextWrapping="Wrap" />
                    </StackPanel>

                    <Border
                        x:Name="InstalledBadge"
                        Grid.Column="1"
                        Padding="8,3"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="{ThemeResource BrandSoftBrush}"
                        CornerRadius="4"
                        Visibility="Collapsed">
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource LinkTextBrush}"
                            Text="已安装" />
                    </Border>
                </Grid>
            </StackPanel>

            <ScrollViewer
                x:Name="DetailScroll"
                Grid.Row="1"
                Margin="0,24,0,0"
                Style="{StaticResource PageScrollStyle}">
                <StackPanel>

                    <TextBlock
                        Style="{StaticResource SectionTitleTextStyle}"
                        Text="选择模组加载器" />
                    <TextBlock
                        Margin="0,6,0,16"
                        Style="{StaticResource CaptionTextStyle}"
                        Text="原版只装游戏本体；装了加载器才能用模组。" />

                    <!-- 保留加载器选择卡，按详情区实际宽度换列。 -->
                    <controls:AdaptiveWrapPanel ItemMinWidth="220" MaxColumns="3" Spacing="8">

                        <ToggleButton
                            x:Name="CardVanilla"
                            AutomationProperties.Name="原版"
                            Tag="vanilla"
                            MinHeight="132"
                            Style="{StaticResource LoaderCardStyle}"
                            Click="LoaderCard_Click">
                            <StackPanel>
                                <Image Width="42" Height="42" HorizontalAlignment="Left" Source="ms-appx:///Assets/Blocks/vanilla.png" />
                                <TextBlock Margin="0,12,0,0" Style="{StaticResource CardTitleTextStyle}" Text="原版" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource CardStatusTextStyle}" Text="纯净游戏本体" />
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton
                            x:Name="CardFabric"
                            AutomationProperties.Name="Fabric"
                            Tag="fabric"
                            MinHeight="132"
                            Style="{StaticResource LoaderCardStyle}"
                            Click="LoaderCard_Click">
                            <StackPanel>
                                <Image Width="42" Height="42" HorizontalAlignment="Left" Source="ms-appx:///Assets/Blocks/fabric.png" />
                                <TextBlock Margin="0,12,0,0" Style="{StaticResource CardTitleTextStyle}" Text="Fabric" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource CardStatusTextStyle}" Text="轻量、跟进快" />
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton
                            x:Name="CardForge"
                            AutomationProperties.Name="Forge"
                            Tag="forge"
                            MinHeight="132"
                            Style="{StaticResource LoaderCardStyle}"
                            Click="LoaderCard_Click">
                            <StackPanel>
                                <Image Width="42" Height="42" HorizontalAlignment="Left" Source="ms-appx:///Assets/Blocks/forge.png" />
                                <TextBlock Margin="0,12,0,0" Style="{StaticResource CardTitleTextStyle}" Text="Forge" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource CardStatusTextStyle}" Text="老牌、模组最多" />
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton
                            x:Name="CardNeoForge"
                            AutomationProperties.Name="NeoForge"
                            Tag="neoforge"
                            MinHeight="132"
                            Style="{StaticResource LoaderCardStyle}"
                            Click="LoaderCard_Click">
                            <StackPanel>
                                <Image Width="42" Height="42" HorizontalAlignment="Left" Source="ms-appx:///Assets/Blocks/neoforge.png" />
                                <TextBlock Margin="0,12,0,0" Style="{StaticResource CardTitleTextStyle}" Text="NeoForge" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource CardStatusTextStyle}" Text="社区接手的新分支" />
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton
                            x:Name="CardQuilt"
                            AutomationProperties.Name="Quilt"
                            Tag="quilt"
                            MinHeight="132"
                            Style="{StaticResource LoaderCardStyle}"
                            Click="LoaderCard_Click">
                            <StackPanel>
                                <Image Width="42" Height="42" HorizontalAlignment="Left" Source="ms-appx:///Assets/Blocks/quilt.png" />
                                <TextBlock Margin="0,12,0,0" Style="{StaticResource CardTitleTextStyle}" Text="Quilt" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource CardStatusTextStyle}" Text="Fabric 的进阶分支" />
                            </StackPanel>
                        </ToggleButton>
                    </controls:AdaptiveWrapPanel>

                    <!-- 加载器版本 -->
                    <StackPanel
                        x:Name="LoaderVersionPanel"
                        Margin="0,20,0,0"
                        Spacing="8"
                        Visibility="Collapsed">
                        <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="加载器版本" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="LoaderVersionBox"
                                MinHeight="32" MaxWidth="360" HorizontalAlignment="Stretch"
                                AutomationProperties.Name="加载器版本"
                                SelectionChanged="LoaderVersion_Changed" />
                            <ProgressRing
                                x:Name="LoaderRing"
                                Grid.Column="1"
                                Width="18"
                                Height="18"
                                VerticalAlignment="Center"
                                Visibility="Collapsed" />
                        </Grid>
                        <TextBlock
                            x:Name="LoaderHint"
                            Style="{StaticResource CaptionTextStyle}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                        <Button x:Name="LoaderRetryButton" Content="重新获取加载器版本"
                                Click="LoaderRetry_Click" Visibility="Collapsed" />
                    </StackPanel>

                    <!-- ================= 实例设置（只对已安装的版本显示） ================= -->
                    <TextBlock
                        x:Name="InstanceSectionTitle"
                        Margin="0,28,0,10"
                        Style="{StaticResource SectionTitleTextStyle}"
                        Text="启动设置"
                        Visibility="Collapsed" />

                    <Border
                        x:Name="InstancePanel"
                        Padding="20,16"
                        Background="{ThemeResource CardBackgroundBrush}"
                        BorderBrush="{ThemeResource DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="Collapsed">
                        <StackPanel Spacing="16">

                            <controls:SettingsRow Title="最大内存 (MB)" Description="这个实例启动时分配的堆大小。">
                                <controls:SettingsRow.Editor>
                                    <NumberBox
                                        x:Name="MemoryBox"
                                        Width="140"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Maximum="65536"
                                        Minimum="1024"
                                        AutomationProperties.Name="实例最大内存（MB）"
                                        SpinButtonPlacementMode="Compact"
                                        ValueChanged="Number_Changed" />
                                </controls:SettingsRow.Editor>
                            </controls:SettingsRow>

                            <controls:SettingsRow Title="窗口分辨率" Description="只影响这个实例；全屏时忽略。">
                                <controls:SettingsRow.Editor>
                                    <StackPanel
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <NumberBox
                                            x:Name="WidthBox"
                                            Width="110"
                                            Maximum="7680"
                                            Minimum="320"
                                            AutomationProperties.Name="实例窗口宽度"
                                            SpinButtonPlacementMode="Compact"
                                            ValueChanged="Number_Changed" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource CaptionTextStyle}"
                                            Text="×" />
                                        <NumberBox
                                            x:Name="HeightBox"
                                            Width="110"
                                            Maximum="4320"
                                            Minimum="240"
                                            AutomationProperties.Name="实例窗口高度"
                                            SpinButtonPlacementMode="Compact"
                                            ValueChanged="Number_Changed" />
                                    </StackPanel>
                                </controls:SettingsRow.Editor>
                            </controls:SettingsRow>

                            <controls:SettingsRow Title="全屏启动" Description="进游戏直接全屏。">
                                <controls:SettingsRow.Editor>
                                    <ToggleSwitch
                                        x:Name="FullscreenSwitch"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="全屏启动"
                                        Toggled="Toggle_Changed" />
                                </controls:SettingsRow.Editor>
                            </controls:SettingsRow>

                            <controls:SettingsRow Title="版本隔离" Description="开启后该版本的模组与存档独立存放。">
                                <controls:SettingsRow.Editor>
                                    <ToggleSwitch
                                        x:Name="IsolatedSwitch"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="版本隔离"
                                        Toggled="Toggle_Changed" />
                                </controls:SettingsRow.Editor>
                            </controls:SettingsRow>
                        </StackPanel>
                    </Border>

                    <!-- 实例信息 -->
                    <TextBlock
                        x:Name="InstanceInfoTitle"
                        Margin="0,24,0,10"
                        Style="{StaticResource SectionTitleTextStyle}"
                        Text="实例"
                        Visibility="Collapsed" />

                    <controls:AdaptiveWrapPanel x:Name="InstanceInfoPanel" ItemMinWidth="180"
                                                MaxColumns="3" Spacing="8" Visibility="Collapsed">

                        <Border
                            Padding="16,14"
                            Background="{ThemeResource CardBackgroundBrush}"
                            BorderBrush="{ThemeResource DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="5">
                                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="占用空间" />
                                <TextBlock x:Name="SizeValue" Style="{StaticResource MetricValueTextStyle}" Text="—" />
                            </StackPanel>
                        </Border>

                        <Border
                            Padding="16,14"
                            Background="{ThemeResource CardBackgroundBrush}"
                            BorderBrush="{ThemeResource DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="5">
                                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="Mod" />
                                <TextBlock x:Name="ModCountValue" Style="{StaticResource MetricValueTextStyle}" Text="—" />
                            </StackPanel>
                        </Border>

                        <Border
                            Padding="16,14"
                            Background="{ThemeResource CardBackgroundBrush}"
                            BorderBrush="{ThemeResource DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="5">
                                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="存档" />
                                <TextBlock x:Name="SavesValue" Style="{StaticResource MetricValueTextStyle}" Text="—" />
                            </StackPanel>
                        </Border>
                    </controls:AdaptiveWrapPanel>

                    <controls:AdaptiveWrapPanel Spacing="8">
                        <Button
                            x:Name="OpenModsButton"
                            Margin="0,12,0,0"
                            Click="OpenMods_Click"
                            Content="打开 mods 文件夹"
                            Visibility="Collapsed" />

                        <Button
                            x:Name="CheckModUpdateButton"
                            Margin="0,12,0,0"
                            Click="CheckModUpdate_Click"
                            Content="检查 Mod 更新"
                            Visibility="Collapsed" />
                    </controls:AdaptiveWrapPanel>

                    <Button
                        x:Name="RepairButton"
                        Margin="0,8,0,0"
                        Click="Repair_Click"
                        Content="校验并修复文件"
                        Visibility="Collapsed" />

                    <Button
                        x:Name="DeleteButton"
                        Margin="0,8,0,0"
                        Click="Delete_Click"
                        Content="删除这个版本"
                        Visibility="Collapsed" />

                    <!-- ================= Mod 管理 ================= -->
                    <TextBlock
                        x:Name="ModSectionTitle"
                        Margin="0,24,0,10"
                        Style="{StaticResource SectionTitleTextStyle}"
                        Text="Mod 管理"
                        Visibility="Collapsed" />

                    <Border
                        x:Name="ModPanel"
                        Padding="16,14"
                        AllowDrop="True"
                        Background="{ThemeResource CardBackgroundBrush}"
                        BorderBrush="{ThemeResource DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        DragOver="Mods_DragOver"
                        Drop="Mods_Drop"
                        Visibility="Collapsed">
                        <StackPanel Spacing="10">
                            <TextBlock
                                Style="{StaticResource CaptionTextStyle}"
                                Text="把 .jar 拖到这里即可安装；也可以在这里禁用或卸载。" />

                            <TextBlock
                                x:Name="ModEmptyHint"
                                Style="{StaticResource BodyTextStyle}"
                                Text="还没有安装任何 Mod。" />

                            <ListView
                                x:Name="ModList"
                                SelectionMode="None"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollMode="Disabled">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="CornerRadius" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid
                                            Padding="0,8"
                                            ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <FontIcon
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                FontSize="15"
                                                Foreground="{ThemeResource SecondaryTextBrush}"
                                                Glyph="&#xE7B8;" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock
                                                    Style="{StaticResource CardTitleTextStyle}"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    Style="{StaticResource CardStatusTextStyle}"
                                                    Text="{Binding Info}" />
                                            </StackPanel>

                                            <Button
                                                Grid.Column="2"
                                                MinHeight="32"
                                                Padding="12,0"
                                                VerticalAlignment="Center"
                                                Click="ModToggle_Click"
                                                Content="{Binding ToggleText}"
                                                FontSize="12"
                                                Tag="{Binding}" />

                                            <Button
                                                Grid.Column="3"
                                                MinHeight="32"
                                                Padding="12,0"
                                                VerticalAlignment="Center"
                                                Click="ModDelete_Click"
                                                Content="卸载"
                                                FontSize="12"
                                                Tag="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <InfoBar
                        x:Name="WarnBar"
                        Margin="0,16,0,0"
                        IsClosable="False"
                        IsOpen="False"
                        Severity="Warning" />

                    <!-- 安装动作 -->
                    <Border
                        Margin="0,24,0,0"
                        Padding="20,18"
                        Background="{ThemeResource ThreatCardBackgroundBrush}"
                        CornerRadius="8">
                        <Grid x:Name="InstallLayout" ColumnSpacing="20" RowSpacing="12"
                              SizeChanged="InstallLayout_SizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="InstallSummary"
                                    Style="{StaticResource BodyTextStyle}"
                                    Text="将安装" TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="InstallHint"
                                    Margin="0,3,0,0"
                                    Style="{StaticResource CardStatusTextStyle}"
                                    Text="客户端 / 依赖库 / 资源文件" TextWrapping="Wrap" />
                            </StackPanel>

                            <controls:AdaptiveWrapPanel x:Name="InstallActions" Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Spacing="8">
                                <Button
                                    Click="Back_Click"
                                    Content="返回"
                                    MinHeight="32"
                                    MinWidth="88" />
                                <Button
                                    x:Name="InstallButton"
                                    MinWidth="112"
                                    MinHeight="32"
                                    Click="Install_Click"
                                    Content="下载并安装"
                                    Style="{StaticResource AccentButtonStyle}" />
                            </controls:AdaptiveWrapPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
