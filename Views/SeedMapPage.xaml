<Page x:Class="LinxLauncher.Views.SeedMapPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LinxLauncher.Controls"
    Background="Transparent" NavigationCacheMode="Enabled">
    <Grid Padding="20,12,20,16" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <controls:PageBreadcrumb ParentTitle="工具箱" CurrentTitle="种子地图" ParentClicked="Back_Click" />
        <ContentControl x:Name="Host" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
</Page>
