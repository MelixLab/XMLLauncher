<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LinxLauncher.Views.SkinsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource PageLayerBackgroundBrush}"
    mc:Ignorable="d">

    <ScrollViewer Style="{StaticResource PageScrollStyle}">
        <Grid x:Name="PageContent" Style="{StaticResource PageContentStyle}" SizeChanged="PageContent_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  标题  -->
            <StackPanel
                Grid.Row="0"
                MaxWidth="620"
                HorizontalAlignment="Left">
                <Button
                    Margin="0,0,0,10"
                    Click="Back_Click"
                    AutomationProperties.Name="返回账户"
                    Style="{StaticResource PageBackButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon FontFamily="{StaticResource IconFontFamily}" FontSize="14" VerticalAlignment="Center" Glyph="&#xE72B;" />
                        <TextBlock Text="返回账户" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="皮肤" />
                <TextBlock
                    Margin="0,11,0,0"
                    Style="{StaticResource PageSubtitleTextStyle}"
                    Text="选择账户，导入、同步或上传皮肤。拖动角色可旋转查看。" />
            </StackPanel>

            <!--  账户选择：单独一行，不跟标题抢位置  -->
            <Grid
                x:Name="AccountRow"
                Grid.Row="1"
                Margin="0,20,0,0"
                ColumnSpacing="12" RowSpacing="8" SizeChanged="AccountRow_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{ThemeResource SecondaryTextBrush}"
                    Text="正在查看" />

                <ComboBox
                    x:Name="AccountPicker"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="正在查看的账户"
                    SelectionChanged="AccountPicker_SelectionChanged" />

                <TextBlock
                    x:Name="DefaultHint"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource SecondaryTextBrush}"
                    Text="" TextWrapping="Wrap" />
            </Grid>

            <!--  内容  -->
            <Grid
                x:Name="SkinContent"
                Grid.Row="2"
                Margin="0,16,0,0"
                ColumnSpacing="16" RowSpacing="16" SizeChanged="SkinContent_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="PreviewColumn" Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  预览卡  -->
                <Border
                    x:Name="PreviewCard"
                    Grid.Column="0"
                    Padding="20"
                    VerticalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundBrush}"
                    BorderBrush="{ThemeResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                x:Name="AvatarFrame"
                                Width="64"
                                Height="64"
                                VerticalAlignment="Top"
                                Background="{ThemeResource CardHoverBackgroundBrush}"
                                CornerRadius="6">
                                <Grid>
                                    <TextBlock
                                        x:Name="AvatarInitial"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="28"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource SecondaryTextBrush}"
                                        Text="S"
                                        Visibility="Collapsed" />
                                    <Image
                                        x:Name="AvatarImage"
                                        Stretch="Fill" />
                                </Grid>
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Top"
                                Spacing="2">
                                <TextBlock
                                    x:Name="PreviewName" LineHeight="24" LineStackingStrategy="BlockLineHeight"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource PrimaryTextBrush}"
                                    Text="Steve"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="PreviewMeta" LineHeight="18" LineStackingStrategy="BlockLineHeight"
                                    FontSize="12"
                                    Foreground="{ThemeResource SecondaryTextBrush}"
                                    Text="离线账户" TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="PreviewSource" LineHeight="18" LineStackingStrategy="BlockLineHeight"
                                    FontSize="12"
                                    Foreground="{ThemeResource SecondaryTextBrush}"
                                    Text="默认皮肤" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Rectangle Grid.Row="1" Height="1" Fill="{ThemeResource DividerBrush}" />

                        <!-- 3D 模型填满两张卡片对齐后剩余的预览空间 -->
                        <Border Grid.Row="2"
                            Background="{ThemeResource CardHoverBackgroundBrush}"
                            CornerRadius="8">
                            <Grid
                                x:Name="SkinModelHost"
                                MinHeight="280"
                                Background="Transparent"
                                ManipulationMode="None"
                                SizeChanged="SkinModelHost_SizeChanged"
                                PointerCanceled="SkinModel_Released"
                                PointerCaptureLost="SkinModel_Released"
                                PointerMoved="SkinModel_Moved"
                                PointerPressed="SkinModel_Pressed"
                                PointerReleased="SkinModel_Released">
                                <Image
                                    x:Name="SkinModel3D"
                                    IsHitTestVisible="False"
                                    Stretch="Uniform" />
                                <TextBlock
                                    x:Name="SkinModelHint"
                                    Margin="8,0,8,10"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    FontSize="12"
                                    Foreground="{ThemeResource SecondaryTextBrush}"
                                    IsHitTestVisible="False"
                                    Text="按住拖动可以转一圈"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <TextBlock
                            x:Name="EmptyHint" Grid.Row="3"
                            FontSize="13"
                            Foreground="{ThemeResource SecondaryTextBrush}"
                            Text=""
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <!--  设置卡  -->
                <Border
                    x:Name="EditingCard"
                    Grid.Column="1"
                    Padding="20"
                    VerticalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundBrush}"
                    BorderBrush="{ThemeResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="换皮肤" />
                            <TextBlock
                                FontSize="13"
                                Foreground="{ThemeResource SecondaryTextBrush}"
                                Text="支持 64×64（现代）和 64×32（旧版）的 PNG。其他尺寸会被判定为不是皮肤。"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <Button
                                x:Name="ImportButton"
                                HorizontalAlignment="Left"
                                Click="Import_Click"
                                Content="导入皮肤…"
                                Style="{StaticResource AccentButtonStyle}" />

                            <Button
                                x:Name="SyncButton"
                                HorizontalAlignment="Left"
                                Click="Sync_Click"
                                Content="从正版角色档案同步"
                                Style="{StaticResource DefaultButtonStyle}"
                                MinWidth="180" />

                            <Button
                                x:Name="UploadButton"
                                HorizontalAlignment="Left"
                                Click="Upload_Click"
                                Content="上传成我的正版皮肤"
                                Style="{StaticResource DefaultButtonStyle}"
                                MinWidth="180" />

                            <Button
                                x:Name="ClearButton"
                                HorizontalAlignment="Left"
                                Click="Clear_Click"
                                Content="恢复默认皮肤"
                                Style="{StaticResource DefaultButtonStyle}"
                                MinWidth="180" />
                        </StackPanel>

                        <Rectangle Height="1" Fill="{ThemeResource DividerBrush}" />

                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="模型" />
                            <TextBlock
                                FontSize="13"
                                Foreground="{ThemeResource SecondaryTextBrush}"
                                Text="经典是 4 像素宽的手臂（Steve），Slim 是 3 像素（Alex）。没设置皮肤时，这里决定用哪张默认皮肤。"
                                TextWrapping="Wrap" />
                            <RadioButtons
                                x:Name="ModelChoice"
                                MaxColumns="2"
                                SelectionChanged="ModelChoice_SelectionChanged">
                                <x:String>Classic · 经典</x:String>
                                <x:String>Slim · 细手臂</x:String>
                            </RadioButtons>
                        </StackPanel>

                        <Rectangle Height="1" Fill="{ThemeResource DividerBrush}" />

                        <TextBlock
                            x:Name="StatusText"
                            FontSize="13"
                            Foreground="{ThemeResource SecondaryTextBrush}"
                            Text=""
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
