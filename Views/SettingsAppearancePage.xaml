<?xml version="1.0" ?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:LinxLauncher.Controls" x:Class="LinxLauncher.Views.SettingsAppearancePage" NavigationCacheMode="Required" Background="Transparent">
    <ScrollViewer Style="{StaticResource SettingsScrollStyle}">
        <Grid Style="{StaticResource PageContentStyle}" Padding="32,16,32,24">
            <StackPanel Spacing="28">
                <StackPanel>
                    <TextBlock Text="主题与材质" Style="{StaticResource SettingsGroupHeadingStyle}"/>
                    <StackPanel Spacing="4">
                        <Border Style="{StaticResource SettingsItemCardStyle}">
                            <controls:SettingsRow IconGlyph="&#xE706;" Title="主题模式" Description="选择浅色、深色，或跟随 Windows 系统设置。">
                                <controls:SettingsRow.Editor>
                                    <ComboBox x:Name="ThemeModeBox" MinWidth="0" HorizontalAlignment="Right" SelectionChanged="ThemeMode_Changed" AutomationProperties.Name="主题模式">
                                        <ComboBoxItem Content="跟随系统"/>
                                        <ComboBoxItem Content="浅色"/>
                                        <ComboBoxItem Content="深色"/>
                                    </ComboBox>
                                </controls:SettingsRow.Editor>
                            </controls:SettingsRow>
                        </Border>
                        <controls:SettingsExpander x:Name="MaterialCard" IsHeaderToggleVisible="False" Padding="18,18" AutomationProperties.Name="窗口材质">
                            <controls:SettingsExpander.Header>
                                <StackPanel Spacing="14">
                                    <controls:SettingsRow IconGlyph="&#xE7F4;" Title="窗口材质" Description="预览纯色、云母与磨砂玻璃的不同层次。"/>
                                    <controls:AdaptiveWrapPanel x:Name="MaterialHost" Spacing="10"/>
                                    <TextBlock x:Name="MaterialNote" Style="{StaticResource CaptionTextStyle}"/>
                                </StackPanel>
                            </controls:SettingsExpander.Header>
                            <StackPanel Spacing="16">
                                <controls:SettingsRow IconGlyph="&#xE737;" Title="通透程度" Description="提高数值可减少底色覆盖。">
                                    <controls:SettingsRow.Editor>
                                        <Grid Width="260" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="48"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="TransparencySlider" Minimum="0" Maximum="100" StepFrequency="1" VerticalAlignment="Center" ValueChanged="Acrylic_Changed" AutomationProperties.Name="亚克力通透程度"/>
                                            <TextBlock x:Name="TransparencyValue" Grid.Column="1" Style="{StaticResource MetricValueTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </controls:SettingsRow.Editor>
                                </controls:SettingsRow>
                                <controls:SettingsRow IconGlyph="&#xE790;" Title="鲜艳程度" Description="提高数值可让背景更鲜艳。">
                                    <controls:SettingsRow.Editor>
                                        <Grid Width="260" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="48"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="VividnessSlider" Minimum="0" Maximum="100" StepFrequency="1" VerticalAlignment="Center" ValueChanged="Acrylic_Changed" AutomationProperties.Name="亚克力鲜艳程度"/>
                                            <TextBlock x:Name="VividnessValue" Grid.Column="1" Style="{StaticResource MetricValueTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </controls:SettingsRow.Editor>
                                </controls:SettingsRow>
                                <TextBlock Text="系统关闭透明效果或窗口未激活时，材质外观可能有所不同。" Style="{StaticResource CaptionTextStyle}"/>
                            </StackPanel>
                        </controls:SettingsExpander>
                        <Border Style="{StaticResource SettingsItemCardStyle}">
                            <controls:SettingsRow IconGlyph="&#xE81E;" Title="内容区域不透明度" Description="降低数值可透出更多窗口材质；纯色材质下无效。">
                                <controls:SettingsRow.Editor>
                                    <Grid Width="260" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="48"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="SurfaceSlider" Minimum="0.15" Maximum="1" StepFrequency="0.05" VerticalAlignment="Center" ValueChanged="Surface_Changed" AutomationProperties.Name="内容区域不透明度"/>
                                        <TextBlock x:Name="OpacityValue" Grid.Column="1" Style="{StaticResource MetricValueTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </controls:SettingsRow.Editor>
                            </controls:SettingsRow>
                        </Border>
                    </StackPanel>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="主题色" Style="{StaticResource SettingsGroupHeadingStyle}"/>
                    <Border Style="{StaticResource SettingsItemCardStyle}" Padding="20" Background="{ThemeResource BrandSoftBrush}">
                        <StackPanel Spacing="16">
                            <controls:SettingsRow IconGlyph="&#xE790;" Title="界面强调色" Description="应用于按钮、开关、选中状态与账户信息卡。"/>
                            <Grid x:Name="AccentLayout" ColumnSpacing="16" RowSpacing="12" SizeChanged="AccentLayout_SizeChanged">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <controls:AdaptiveWrapPanel x:Name="AccentHost" Spacing="10" VerticalAlignment="Center"/>
                                <StackPanel x:Name="AccentActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <HyperlinkButton Content="使用品牌默认色" Click="AccentReset_Click" VerticalAlignment="Center"/>
                                    <Button x:Name="CustomAccentButton" Content="自定义" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="AccentNote" Style="{StaticResource CaptionTextStyle}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="卡片外观" Style="{StaticResource SettingsGroupHeadingStyle}"/>
                    <StackPanel Spacing="4">
                        <Border Style="{StaticResource SettingsItemCardStyle}">
                            <controls:SettingsRow IconGlyph="&#xE790;" Title="浅色鼠标灰色光晕"
                                                  Description="浅色模式下显示鼠标周围的柔和灰色阴影；深色模式不受此设置影响。">
                                <controls:SettingsRow.Editor>
                                    <ToggleSwitch x:Name="LightGlowSwitch" Toggled="LightGlow_Toggled"
                                                  AutomationProperties.Name="浅色鼠标灰色光晕"/>
                                </controls:SettingsRow.Editor>
                            </controls:SettingsRow>
                        </Border>
                        <Border Style="{StaticResource SettingsItemCardStyle}">
                            <controls:SettingsRow x:Name="InteractionCardShapeRow" IconGlyph="&#xE790;" Title="交互卡片边角"
                                                  Description="仅影响功能卡片和版本页的加载器选择卡片，全局设置开启时此设置不生效。">
                                <controls:SettingsRow.Editor>
                                    <ComboBox x:Name="CardShapeBox" HorizontalAlignment="Right" MinWidth="112"
                                              SelectionChanged="CardShape_Changed" AutomationProperties.Name="卡片边角">
                                        <ComboBoxItem Content="圆角"/>
                                        <ComboBoxItem Content="直角"/>
                                    </ComboBox>
                                </controls:SettingsRow.Editor>
                            </controls:SettingsRow>
                        </Border>
                        <Border Style="{StaticResource SettingsItemCardStyle}">
                            <controls:SettingsRow IconGlyph="&#xE790;" Title="全局直角（beta）"
                                                  Description="统一卡片、按钮、输入框和下拉框等组件的边角。">
                                <controls:SettingsRow.Editor>
                                    <ToggleSwitch x:Name="GlobalCardShapeSwitch" Toggled="GlobalCardShape_Toggled"
                                                  AutomationProperties.Name="全局直角（beta）"/>
                                </controls:SettingsRow.Editor>
                            </controls:SettingsRow>
                        </Border>
                    </StackPanel>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="标题栏" Style="{StaticResource SettingsGroupHeadingStyle}"/>
                    <Border Style="{StaticResource SettingsItemCardStyle}">
                        <controls:SettingsRow IconGlyph="&#xE737;" Title="使用新版 TitleBar（beta）" Description="提供更现代、功能更强大的标题栏体验。">
                            <controls:SettingsRow.Editor>
                                <ToggleSwitch x:Name="NewTitleBarSwitch" Toggled="NewTitleBar_Toggled"
                                              AutomationProperties.Name="使用新版 TitleBar（beta）"/>
                            </controls:SettingsRow.Editor>
                        </controls:SettingsRow>
                    </Border>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="字体" Style="{StaticResource SettingsGroupHeadingStyle}"/>
                    <Border Style="{StaticResource SettingsItemCardStyle}">
                        <controls:SettingsRow IconGlyph="&#xE8D2;" Title="使用 Noto Sans" Description="切换启动器的界面字体。">
                            <controls:SettingsRow.Editor>
                                <ToggleSwitch x:Name="FontSwitch" Toggled="Font_Toggled" AutomationProperties.Name="正文使用 Noto Sans"/>
                            </controls:SettingsRow.Editor>
                        </controls:SettingsRow>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
