<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LinxLauncher.Views.AccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource PageLayerBackgroundBrush}"
    mc:Ignorable="d">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        HorizontalContentAlignment="Stretch"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">
        <Grid Padding="40,40,40,48">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  标题 + 操作  -->
            <Grid Grid.Row="0">
                <StackPanel
                    MaxWidth="620"
                    HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="账户" />
                    <TextBlock
                        Margin="0,11,0,0"
                        Style="{StaticResource PageSubtitleTextStyle}"
                        Text="一摞账户卡，最上面那张就是进游戏用的身份。点下面任一张，它就抽上来展开。" />
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="AddOfflineButton"
                        Click="AddOffline_Click"
                        Content="添加离线账户" />
                    <Button
                        x:Name="MsLoginButton"
                        Click="MsLogin_Click"
                        Content="登录 Microsoft 账号"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>

            <!--  账户数  -->
            <TextBlock
                x:Name="CountText"
                Grid.Row="1"
                Margin="0,32,0,0"
                FontSize="14"
                Foreground="{ThemeResource SecondaryTextBrush}"
                Text="" />

            <!--  卡包：当前卡完整展开，其余压成信息条叠在下面  -->
            <Canvas
                x:Name="DeckHost"
                Grid.Row="2"
                Width="620"
                Height="140"
                Margin="0,14,0,0"
                HorizontalAlignment="Left" />
        </Grid>
    </ScrollViewer>
</Page>
