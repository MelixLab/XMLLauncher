<?xml version="1.0" ?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:LinxLauncher.Controls" x:Class="LinxLauncher.Views.SettingsAdvancedPage" NavigationCacheMode="Required" Background="Transparent">
    <ScrollViewer Style="{StaticResource SettingsScrollStyle}">
        <Grid Style="{StaticResource PageContentStyle}" Padding="32,16,32,24">
            <StackPanel Spacing="28">
                <StackPanel>
                    <TextBlock Text="启动参数" Style="{StaticResource SettingsGroupHeadingStyle}"/>
                    <StackPanel Spacing="4">
                        <controls:SettingsExpander AutomationProperties.Name="额外 JVM 参数">
                            <controls:SettingsExpander.Header>
                                <controls:SettingsRow IconGlyph="&#xE756;" Title="额外 JVM 参数" Description="自定义 Java 虚拟机启动选项；不确定用途时请留空。"/>
                            </controls:SettingsExpander.Header>
                            <StackPanel Spacing="10">
                                <TextBox x:Name="JvmArgsBox" AcceptsReturn="True" MinHeight="104" MaxHeight="280" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="Args_TextChanged" AutomationProperties.Name="额外 JVM 参数"/>
                                <Button x:Name="JvmSaveButton" Content="保存" HorizontalAlignment="Right" IsEnabled="False" Click="SaveJvm_Click" Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="保存额外 JVM 参数"/>
                            </StackPanel>
                        </controls:SettingsExpander>
                        <controls:SettingsExpander AutomationProperties.Name="额外游戏参数">
                            <controls:SettingsExpander.Header>
                                <controls:SettingsRow IconGlyph="&#xE943;" Title="额外游戏参数" Description="自定义传入游戏的启动选项；不确定用途时请留空。"/>
                            </controls:SettingsExpander.Header>
                            <StackPanel Spacing="10">
                                <TextBox x:Name="GameArgsBox" AcceptsReturn="True" MinHeight="104" MaxHeight="280" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="Args_TextChanged" AutomationProperties.Name="额外游戏参数"/>
                                <Button x:Name="GameSaveButton" Content="保存" HorizontalAlignment="Right" IsEnabled="False" Click="SaveGame_Click" Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="保存额外游戏参数"/>
                            </StackPanel>
                        </controls:SettingsExpander>
                    </StackPanel>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="工具与诊断" Style="{StaticResource SettingsGroupHeadingStyle}"/>
                    <StackPanel Spacing="4">
                        <Border Style="{StaticResource SettingsItemCardStyle}">
                            <controls:SettingsRow IconGlyph="&#xE897;" Title="新手向导" Description="重新了解登录方式、XML 账户与各个页面。不会下载文件，也不会改动版本库。">
                                <controls:SettingsRow.Editor>
                                    <Button Content="重新开始向导" Click="RestartWizard_Click"/>
                                </controls:SettingsRow.Editor>
                            </controls:SettingsRow>
                        </Border>
                        <Border Style="{StaticResource SettingsItemCardStyle}">
                            <controls:SettingsRow IconGlyph="&#xE9D9;" Title="日志管理" Description="查看启动器运行记录，帮助排查问题。">
                                <controls:SettingsRow.Editor>
                                    <Button Content="打开日志目录" Click="OpenLogs_Click"/>
                                </controls:SettingsRow.Editor>
                            </controls:SettingsRow>
                        </Border>
                    </StackPanel>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="应用信息" Style="{StaticResource SettingsGroupHeadingStyle}"/>
                    <Border Style="{StaticResource SettingsItemCardStyle}">
                        <StackPanel Spacing="12">
                            <controls:SettingsRow IconGlyph="&#xE946;" Title="XML Minecraft Launcher" Description="当前版本与本地配置位置。"/>
                            <TextBlock x:Name="AboutText" Style="{StaticResource CaptionTextStyle}" IsTextSelectionEnabled="True"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
