<?xml version="1.0" encoding="utf-8"?>
<!--
    图标资源。
    结构照抄 XIGUASecurity 的 Icons.xaml：48×48 画布 = 主图形（Segoe Fluent 字形）
    + 右下角状态徽章（矢量，32×32 设计稿，Viewbox 可缩放）。
    主图形统一用品牌青绿，状态色只出现在徽章上 —— 不做六张卡六种颜色。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== 状态徽章 ==================== -->

    <DataTemplate x:Key="BadgeGreenCheck">
        <Viewbox Stretch="Uniform">
            <Grid Width="32" Height="32">
                <Ellipse Width="32" Height="32" Fill="{ThemeResource SecurityGreenBrush}" />
                <Path
                    Data="M9.6,16.6 L13.9,20.9 L22.6,11.4"
                    Stroke="#FFFFFF"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="3.4" />
            </Grid>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="BadgeRedCross">
        <Viewbox Stretch="Uniform">
            <Grid Width="32" Height="32">
                <Ellipse Width="32" Height="32" Fill="{ThemeResource SecurityRedBrush}" />
                <Path
                    Data="M11,11 L21,21 M21,11 L11,21"
                    Stroke="#FFFFFF"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="3.4" />
            </Grid>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="BadgeAmberWarn">
        <Viewbox Stretch="Uniform">
            <Grid Width="32" Height="32">
                <Ellipse Width="32" Height="32" Fill="{ThemeResource SecurityAmberBrush}" />
                <Path
                    Data="M16,9 L16,18 M16,22 L16,22.4"
                    Stroke="#FFFFFF"
                    StrokeEndLineCap="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="3.4" />
            </Grid>
        </Viewbox>
    </DataTemplate>

    <!-- ==================== 概览卡片图标 ==================== -->

    <!-- 当前版本：Minecraft 原版草方块 + 绿勾 -->
    <DataTemplate x:Key="IconCardGame">
        <Grid Width="56" Height="56">
            <Image
                Width="52"
                Height="52"
                Source="ms-appx:///Assets/Blocks/vanilla.png" />
            <ContentControl
                Width="20"
                Height="20"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Content="."
                ContentTemplate="{StaticResource BadgeGreenCheck}" />
        </Grid>
    </DataTemplate>

    <!-- 模组加载器：Fabric 方块（原图四周留白多，所以画得比别的块略大） -->
    <DataTemplate x:Key="IconCardLoader">
        <Grid Width="56" Height="56">
            <Image
                Width="56"
                Height="56"
                Source="ms-appx:///Assets/Blocks/fabric.png" />
        </Grid>
    </DataTemplate>

    <!-- 下载加速：铁砧 + 绿勾 -->
    <DataTemplate x:Key="IconCardDownload">
        <Grid Width="56" Height="56">
            <Image
                Width="52"
                Height="52"
                Source="ms-appx:///Assets/Blocks/anvil.png" />
            <ContentControl
                Width="20"
                Height="20"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Content="."
                ContentTemplate="{StaticResource BadgeGreenCheck}" />
        </Grid>
    </DataTemplate>

    <!-- 已安装版本：书本 -->
    <DataTemplate x:Key="IconCardLibrary">
        <Grid Width="56" Height="56">
            <Image
                Width="50"
                Height="50"
                Source="ms-appx:///Assets/Blocks/book.png" />
        </Grid>
    </DataTemplate>

    <!-- Java 运行时：命令方块 -->
    <DataTemplate x:Key="IconCardJava">
        <Grid Width="56" Height="56">
            <Image
                Width="52"
                Height="52"
                Source="ms-appx:///Assets/Blocks/command.png" />
        </Grid>
    </DataTemplate>

    <!-- 下载任务：时钟 -->
    <DataTemplate x:Key="IconCardTask">
        <Grid Width="56" Height="56">
            <Image
                Width="50"
                Height="50"
                Source="ms-appx:///Assets/Blocks/clock.png" />
        </Grid>
    </DataTemplate>


</ResourceDictionary>
