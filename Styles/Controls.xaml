<?xml version="1.0" encoding="utf-8"?>
<!--
    XIGUASecurity · 控件样式
    复刻 XIGUASecurity里的按钮、链接、开关等控件外观。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:LinxLauncher.Services">

    <!-- 原生 Button 模板：常态保留旧灰底，悬停/按压使用主题色，并叠加一次性扫光。 -->
    <Style x:Key="CardActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Background" Value="{ThemeResource CardActionBackgroundBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="services:InteractionMotion.IsEnabled" Value="True" />
        <Setter Property="services:ButtonEffects.IsEnabled" Value="True" />
    </Style>

    <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="services:InteractionMotion.IsEnabled" Value="True" />
        <Setter Property="services:ButtonEffects.IsEnabled" Value="True" />
    </Style>

    <!-- ==================================================================
         蓝色文字链接（获取帮助 / 隐私设置 / 允许的威胁 / 保护历史记录 …）
         实测色值 #003E92；注意 Defender 的这类链接**没有下划线**
         ================================================================== -->
    <Style x:Key="LinkHyperlinkStyle" TargetType="HyperlinkButton">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource LinkTextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HyperlinkButton">
                    <Grid Background="Transparent" Padding="{TemplateBinding Padding}">
                        <!--
                            必须带 x:Name —— VisualState 的 Setter 是按**元素名**解析的，
                            匿名的 ContentPresenter 在 PointerOver / Pressed 触发时解析不了，
                            直接抛 COMException(0x800F1000)「could not be resolved for a Setter」，
                            而这个异常发生在 XAML 内部，try/catch 抓不到，表现为鼠标一悬停就闪退。
                        -->
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="{TemplateBinding FontSize}"
                            Foreground="{TemplateBinding Foreground}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Opacity" Value="0.75" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Opacity" Value="0.55" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================================
         Defender 风格开关：滑块在左、状态文字在右（XIGUASecurity的做法，
         与「设置」应用的左文右开关正好相反）
         ================================================================== -->
    <Style
        x:Key="DefenderToggleSwitchStyle"
        BasedOn="{StaticResource DefaultToggleSwitchStyle}"
        TargetType="ToggleSwitch">
        <!--
            直接复用 WinUI 自带的 ToggleSwitch 模板：
            · 官方模板里有一个覆盖全控件的透明 Thumb，ToggleSwitch 的「点按 / 拖动切换」
              就是靠它实现的 —— 自己手写模板很容易漏掉它，导致鼠标点了完全没反应，
              而 UIA 的 TogglePattern 依然可用（只修 UI 不修模板时极难察觉）；
            · 滑块位移用的是官方 RepositionThemeAnimation，天然带滑移动画。
            配色资源在 Theme.xaml 里按 Defender 取样值覆盖。
        -->
        <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinWidth" Value="0" />
    </Style>

    <!-- ==================================================================
         带下拉箭头的大号灰按钮（保护历史记录的「筛选器」/「操作」）
         实测：高 32 DIP、最小宽 120 DIP、圆角 4、填充 #D2D2D2、
               文字与箭头整体居中、间距约 12 DIP
         ================================================================== -->
    <Style x:Key="RecordActionButtonStyle" TargetType="Button">
        <Setter Property="services:CardAppearance.IsCard" Value="True" />
        <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
        <Setter Property="Background" Value="{ThemeResource CardActionBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource CardActionHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource CardActionPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <ContentPresenter
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="{TemplateBinding FontSize}"
                                FontWeight="{TemplateBinding FontWeight}"
                                Foreground="{TemplateBinding Foreground}" />
                            <FontIcon
                                Margin="10,2,0,0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource IconFontFamily}"
                                FontSize="12"
                                Foreground="{TemplateBinding Foreground}"
                                Glyph="&#xE70D;" />
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================================
         扫描选项的单选按钮
         实测（125% 截图换算）：外圈 20 DIP；选中时是一枚实心蓝圆 + 中间
         10 DIP 的白色圆孔（不是「细环 + 小圆点」）；未选中是 1.5 DIP 灰环。
         内容（标题 + 说明）放在第 2 列，说明自然与标题左边缘对齐。
         ================================================================== -->
    <Style x:Key="ScanOptionRadioStyle" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                            <Ellipse
                                x:Name="Hole"
                                Width="20"
                                Height="20"
                                Fill="{ThemeResource RadioCircleOnBrush}"
                                Visibility="Collapsed" />
                            <Ellipse
                                x:Name="Dot"
                                Width="10"
                                Height="10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource RadioHoleBrush}"
                                Visibility="Collapsed" />
                            <Ellipse
                                x:Name="Ring"
                                Width="20"
                                Height="20"
                                Fill="Transparent"
                                Stroke="{ThemeResource RadioCircleOffBrush}"
                                StrokeThickness="1.5" />
                        </Grid>

                        <ContentPresenter
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            VerticalAlignment="Top"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="{TemplateBinding FontSize}"
                            Foreground="{TemplateBinding Foreground}" />

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Ring.Stroke" Value="{ThemeResource RadioCircleOffPointerOverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Ring.Stroke" Value="{ThemeResource RadioCircleOffPointerOverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Ring.Opacity" Value="0.4" />
                                        <Setter Target="Hole.Opacity" Value="0.4" />
                                        <Setter Target="Dot.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Ring.Visibility" Value="Collapsed" />
                                        <Setter Target="Hole.Visibility" Value="Visible" />
                                        <Setter Target="Dot.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked">
                                    <VisualState.Setters>
                                        <Setter Target="Ring.Visibility" Value="Visible" />
                                        <Setter Target="Hole.Visibility" Value="Collapsed" />
                                        <Setter Target="Dot.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Indeterminate">
                                    <VisualState.Setters>
                                        <Setter Target="Ring.Visibility" Value="Visible" />
                                        <Setter Target="Hole.Visibility" Value="Collapsed" />
                                        <Setter Target="Dot.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================================
         侧边栏 NavigationView：去掉面板底色与边框，让导航栏直接贴在窗口底色上
         （与 XIGUASecurity一致）
         ================================================================== -->
    <Style x:Key="SecurityNavigationViewStyle" TargetType="NavigationView">
        <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="IsSettingsVisible" Value="True" />
        <Setter Property="IsBackButtonVisible" Value="Visible" />
        <Setter Property="IsPaneToggleButtonVisible" Value="True" />
        <Setter Property="PaneDisplayMode" Value="LeftCompact" />
        <Setter Property="CompactPaneLength" Value="48" />
        <Setter Property="OpenPaneLength" Value="280" />
        <Setter Property="AlwaysShowHeader" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="IsTitleBarAutoPaddingEnabled" Value="False" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>
    <!-- 选择卡统一由 ToggleButton 的状态控制配色，避免局部画笔覆盖主题或悬停态。 -->
    <Style x:Key="SelectionCardStyle" TargetType="ToggleButton">
        <Setter Property="services:CardAppearance.IsCard" Value="True" />
        <Setter Property="services:InteractionMotion.IsEnabled" Value="True" />
        <Setter Property="services:InteractionMotion.HoverScale" Value="1.01" />
        <Setter Property="services:InteractionMotion.PressedScale" Value="0.97" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <ContentPresenter
                        x:Name="Root"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        ContentTransitions="{TemplateBinding ContentTransitions}"
                        FontFamily="{TemplateBinding FontFamily}"
                        FontSize="{TemplateBinding FontSize}"
                        Foreground="{TemplateBinding Foreground}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource CardHoverBackgroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource CardPressedBackgroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource BrandSoftBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource BrandBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource BrandSoftBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource BrandBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource BrandSoftBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource BrandBrush}" />
                                        <Setter Target="Root.Opacity" Value="0.85" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource BrandSoftBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource BrandBrush}" />
                                        <Setter Target="Root.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ContentPresenter>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LoaderCardStyle" TargetType="ToggleButton" BasedOn="{StaticResource SelectionCardStyle}">
        <Setter Property="services:CardAppearance.IsInteractiveCard" Value="True" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="18,16" />
    </Style>

    <!-- 四个设置分类共享卡片、分组标题和滚动区域，沿用本文件现有文字与主题资源。 -->
    <Style x:Key="SettingsCardStyle" TargetType="Border">
        <Setter Property="services:CardAppearance.IsCard" Value="True" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="SettingsSectionStyle" TargetType="TextBlock" BasedOn="{StaticResource CardTitleTextStyle}">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- 四个设置分类共享单项设置行和环境/身份摘要。 -->
    <Style x:Key="SettingsItemCardStyle" TargetType="Border" BasedOn="{StaticResource SettingsCardStyle}">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="18,14" />
        <Setter Property="MinHeight" Value="76" />
    </Style>
    <Style x:Key="SettingsInfoCardStyle" TargetType="Border" BasedOn="{StaticResource SettingsCardStyle}">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="MinHeight" Value="256" />
    </Style>
    <Style x:Key="SettingsGroupHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingsSectionStyle}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style x:Key="SettingsExpanderHeaderStyle" TargetType="ToggleButton">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="76" />
        <Setter Property="Padding" Value="18,14" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="HeaderRoot" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                          CornerRadius="{TemplateBinding CornerRadius}" ColumnSpacing="20">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="HeaderRoot.Background" Value="{ThemeResource CardHoverBackgroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="HeaderRoot.Background" Value="{ThemeResource CardPressedBackgroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="HeaderRoot.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Chevron.Glyph" Value="&#xE70E;" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Chevron.Glyph" Value="&#xE70E;" />
                                        <Setter Target="HeaderRoot.Background" Value="{ThemeResource CardHoverBackgroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Chevron.Glyph" Value="&#xE70E;" />
                                        <Setter Target="HeaderRoot.Background" Value="{ThemeResource CardPressedBackgroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" />
                        <FontIcon x:Name="Chevron" Grid.Column="1" Glyph="&#xE70D;" FontSize="12" Width="16"
                                  FontFamily="{StaticResource IconFontFamily}" Foreground="{ThemeResource SecondaryTextBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SettingsScrollStyle" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="HorizontalScrollMode" Value="Disabled" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <!-- 页面基线：标题与内容放进同一个容器，随可用宽度收缩。 -->
    <Style x:Key="PageContentStyle" TargetType="Grid">
        <Setter Property="MaxWidth" Value="1200" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="32,28,32,24" />
    </Style>
    <Style x:Key="PageScrollStyle" TargetType="ScrollViewer">
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="HorizontalScrollMode" Value="Disabled" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>
    <!-- 内容区返回操作共用 WinUI 原生按钮模板，保留主题配色、交互状态和键盘焦点反馈。 -->
    <Style x:Key="PageBackButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="services:InteractionMotion.IsEnabled" Value="True" />
        <Setter Property="Background" Value="{ThemeResource ButtonBackground}" />
        <Setter Property="Foreground" Value="{ThemeResource ButtonForeground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="{ThemeResource ButtonBorderThemeThickness}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="FeatureCardNavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>
</ResourceDictionary>
