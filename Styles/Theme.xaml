            <SolidColorBrush x:Key="OnBrandTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="PageLayerBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PageLayerBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SplashBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CardHoverBackgroundBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="CardPressedBackgroundBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="DividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NavSelectionBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NavSelectionIndicatorBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <!-- 侧边栏展开时的面板底色（WD 展开后是灰的，不是透明） -->
            <SolidColorBrush x:Key="NavExpandedPaneBackgroundBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <!-- 保护历史记录 / 允许的威胁：展开的那条记录底色 -->
            <SolidColorBrush x:Key="RecordExpandedBackgroundBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="RecordHoverBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="RecordPressedBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <!-- 「当前威胁」的威胁卡片：常态就是一块灰色直角卡片（与主页卡片同一观感） -->
            <SolidColorBrush x:Key="ThreatCardBackgroundBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="ThreatCardHoverBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <!-- 扫描选项的单选按钮 -->
            <SolidColorBrush x:Key="RadioCircleOnBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="RadioHoleBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="RadioCircleOffBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="RadioCircleOffPointerOverBrush" Color="{ThemeResource SystemColorWindowTextColor}" />


            <SolidColorBrush x:Key="PrimaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TertiaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="LinkTextBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="NoticeTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

            <SolidColorBrush x:Key="SecurityBlueBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SecurityGreenBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SecurityRedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SecurityAmberBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SecurityInkBrush" Color="{ThemeResource SystemColorWindowColor}" />

            <!-- 主程序更新横幅（概览页 · 高对比）：跟随系统色，边框保证可见 -->
            <SolidColorBrush x:Key="UpdateBannerBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="UpdateBannerTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

            <SolidColorBrush x:Key="CardActionBackgroundBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="CardActionHoverBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="CardActionPressedBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />

            <!--
                开关（高对比）：这里刻意「不」覆盖 ToggleSwitch* 配色资源。
                框架自带的高对比定义本就成对（颜色键是 <Color>、笔刷键是画笔），
                我们自己再写一遍极容易把 ColorAnimation 用的键写成画笔而踩坑；
                直接沿用系统高对比配色也才是正确做法。
            -->

            <SolidColorBrush x:Key="SettingsDirectoryBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SettingsDirectoryAccentBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SettingsJavaBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SettingsJavaAccentBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <!-- 原生强调按钮与焦点资源直接引用应用主题画笔，运行中切色也同步。 -->
            <SolidColorBrush x:Key="BrandHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="BrandPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <StaticResource x:Key="AccentFillColorDefaultBrush" ResourceKey="BrandBrush" />
            <StaticResource x:Key="AccentFillColorSecondaryBrush" ResourceKey="BrandHoverBrush" />
            <StaticResource x:Key="AccentFillColorTertiaryBrush" ResourceKey="BrandPressedBrush" />
            <StaticResource x:Key="TextOnAccentFillColorPrimaryBrush" ResourceKey="OnBrandTextBrush" />
            <StaticResource x:Key="AccentButtonBackground" ResourceKey="BrandBrush" />
            <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="BrandHoverBrush" />
            <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="BrandPressedBrush" />
            <StaticResource x:Key="AccentButtonForeground" ResourceKey="OnBrandTextBrush" />
            <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="OnBrandTextBrush" />
            <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="OnBrandTextBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- 字体 -->
    <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <LinearGradientBrush x:Key="TopFadeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFFDFDFD" />
        <GradientStop Offset="1" Color="#00FDFDFD" />
    </LinearGradientBrush>

    <!--
        开关：官方 ToggleSwitch 模板默认在滑块上下各留 10 DIP 的内容边距
        （让整控件高 40），这里压成 0，保持设置页原先实测出来的紧凑间距。
    -->
    <x:Double x:Key="ToggleSwitchPreContentMargin">0</x:Double>
    <x:Double x:Key="ToggleSwitchPostContentMargin">0</x:Double>


    <!-- ==================================================================
         字体
         Defender 的标题用 Segoe UI Variable Display —— 字形比传统 Segoe UI
         更圆润，中文回退到 微软雅黑 UI。这里按同样的顺序声明字体族回退链。
         ================================================================== -->
    <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display,Segoe UI Variable,Microsoft YaHei UI,Microsoft YaHei,Segoe UI,Arial</FontFamily>
    <FontFamily x:Key="TextFontFamily">Segoe UI Variable Text,Segoe UI Variable,Microsoft YaHei UI,Microsoft YaHei,Segoe UI,Arial</FontFamily>
    <FontFamily x:Key="NotoFontFamily">Noto Sans SC</FontFamily>

    <!-- ==================================================================
         颜色（浅色 / 深色 / 高对比）
         ================================================================== -->

    <!-- ==================================================================
         字号 / 字重（单位 DIP，取自 Defender 截图实测）
         ================================================================== -->

    <!-- 概览页大标题：24 -->
    <Style x:Key="OverviewTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="LineHeight" Value="32" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 设置类页面大标题：28 -->
    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="LineHeight" Value="36" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 概览页副标题：13，深灰 #484848 -->
    <Style x:Key="OverviewSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="Foreground" Value="{ThemeResource TertiaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 设置页副标题：14 -->
    <Style x:Key="PageSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{ThemeResource TertiaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 小节标题：20 -->
    <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="LineHeight" Value="26" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 正文：15 -->
    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 正文（深色，用于状态行） -->
    <Style x:Key="BodyStrongTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 辅助说明：14 -->
    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 卡片标题：15 -->
    <Style x:Key="CardTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 卡片状态：12 -->
    <Style x:Key="CardStatusTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="17" />
        <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 保护历史记录里每条记录的时间戳：13 -->
    <Style x:Key="RecordDateTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- 红色提示行：14 -->
    <Style x:Key="NoticeTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{ThemeResource NoticeTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" /><Setter Property="FontSize" Value="20" /><Setter Property="LineHeight" Value="26" /><Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style x:Key="MetricLabelTextStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" /><Setter Property="FontSize" Value="12" /><Setter Property="LineHeight" Value="17" /><Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" /><Setter Property="TextWrapping" Value="NoWrap" /></Style>
    <Style x:Key="MetricValueTextStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" /><Setter Property="FontSize" Value="14" /><Setter Property="LineHeight" Value="20" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" /><Setter Property="TextWrapping" Value="NoWrap" /></Style>
</ResourceDictionary>
