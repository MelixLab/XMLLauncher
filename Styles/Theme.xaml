<?xml version="1.0" encoding="utf-8"?>
<!--
    XIGUASecurity · 主题资源
    配色 / 字号 全部取自 XIGUASecurity（XIGUASecurity）实际截图取样，
    取样方法见 tools/probe.ps1 与 tools/bands.ps1。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Default">
            <!-- 版面 -->
            <SolidColorBrush x:Key="PaneBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NavigationPaneBackgroundBrush" Color="#F2F2F2" />
            <!-- 子窗口（例如启动失败提示）用的不透明底色：主窗口开了云母/亚克力时，
                 这些窗口没有材质可透，必须自己有一块实底，否则会透出黑。 -->
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="BrandBrush" Color="#00A88E" />
            <SolidColorBrush x:Key="BrandSoftBrush" Color="#E7F6F2" />
            <SolidColorBrush x:Key="OnBrandTextBrush" Color="#FFFFFF" />
                <LinearGradientBrush x:Key="TopFadeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFFDFDFD" />
        <GradientStop Offset="1" Color="#00FDFDFD" />
    </LinearGradientBrush>
            <SolidColorBrush x:Key="PageLayerBackgroundBrush" Color="#FDFDFD" />
            <SolidColorBrush x:Key="PageLayerBorderBrush" Color="#F0F0F0" />
            <!-- 开屏底色：跟着安全中心走纯白（不是页面那层 #FDFDFD） -->
            <SolidColorBrush x:Key="SplashBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardHoverBackgroundBrush" Color="#EBEBEB" />
            <SolidColorBrush x:Key="CardPressedBackgroundBrush" Color="#D0D0D0" />
            <SolidColorBrush x:Key="DividerBrush" Color="#E5E5E5" />
            <SolidColorBrush x:Key="NavSelectionBackgroundBrush" Color="#F6F6F6" />
            <SolidColorBrush x:Key="NavSelectionIndicatorBrush" Color="#00A88E" />
            <!-- 保护历史记录 / 允许的威胁：展开的那条记录底色 -->
            <SolidColorBrush x:Key="RecordExpandedBackgroundBrush" Color="#F2F2F2" />
            <SolidColorBrush x:Key="RecordHoverBackgroundBrush" Color="#EDEDED" />
            <SolidColorBrush x:Key="RecordPressedBackgroundBrush" Color="#E6E6E6" />
            <!-- 「当前威胁」的威胁卡片：常态就是一块灰色直角卡片（与主页卡片同一观感） -->
            <SolidColorBrush x:Key="ThreatCardBackgroundBrush" Color="#F2F2F2" />
            <SolidColorBrush x:Key="ThreatCardHoverBackgroundBrush" Color="#EAEAEA" />
            <!-- 扫描选项的单选按钮 -->
            <SolidColorBrush x:Key="RadioCircleOnBrush" Color="#00A88E" />
            <SolidColorBrush x:Key="RadioHoleBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="RadioCircleOffBrush" Color="#8A8A8A" />
            <SolidColorBrush x:Key="RadioCircleOffPointerOverBrush" Color="#5F5F5F" />


            <!-- 文字 -->
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1B1B1B" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#606060" />
            <SolidColorBrush x:Key="TertiaryTextBrush" Color="#484848" />
            <SolidColorBrush x:Key="LinkTextBrush" Color="#006B5B" />
            <SolidColorBrush x:Key="NoticeTextBrush" Color="#C50500" />

            <!-- 语义色（图标） -->
            <SolidColorBrush x:Key="SecurityBlueBrush" Color="#00A88E" />
            <SolidColorBrush x:Key="SecurityGreenBrush" Color="#008A17" />
            <SolidColorBrush x:Key="SecurityRedBrush" Color="#D82128" />
            <SolidColorBrush x:Key="SecurityAmberBrush" Color="#FFC20A" />
            <SolidColorBrush x:Key="SecurityInkBrush" Color="#1B1B1B" />

            <!-- 主程序更新横幅（概览页）：琥珀底 + 深褐字，WinUI InfoBar 警告配色 -->
            <SolidColorBrush x:Key="UpdateBannerBackgroundBrush" Color="#FFF7E0" />
            <SolidColorBrush x:Key="UpdateBannerTextBrush" Color="#5F4500" />

            <!-- 卡片操作按钮 -->
