            <SolidColorBrush x:Key="CardActionHoverBrush" Color="#C6C6C6" />
            <SolidColorBrush x:Key="CardActionPressedBrush" Color="#B9B9B9" />

            <!-- 开关：滑块在左、状态文字在右（与 Defender 一致）。
                 模板用 WinUI 官方 DefaultToggleSwitchStyle（自带滑移动画），
                 这里只覆盖它的配色资源。 -->
            <!--
                注意类型：官方模板对「悬停 / 按下」用的是
                    ColorAnimation ... TargetProperty="(Shape.Stroke).(SolidColorBrush.Color)"
                也就是说这几个键必须是 <Color>。写成 SolidColorBrush 时动画拿不到 Color，
                会把外框描边直接打成空 —— 表现就是鼠标一靠近边框消失、且没有过渡动画。
            -->
            <SolidColorBrush x:Key="ToggleSwitchContainerBackground" Color="Transparent" />
            <Color x:Key="ToggleSwitchContainerBackgroundPointerOver">#00FFFFFF</Color>
            <Color x:Key="ToggleSwitchContainerBackgroundPressed">#00FFFFFF</Color>
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#F5F5F5" />
            <Color x:Key="ToggleSwitchFillOffPointerOver">#FFF0F0F0</Color>
            <Color x:Key="ToggleSwitchFillOffPressed">#FFE9E9E9</Color>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#8D8D8D" />
            <Color x:Key="ToggleSwitchStrokeOffPointerOver">#FF6E6E6E</Color>
            <Color x:Key="ToggleSwitchStrokeOffPressed">#FF5F5F5F</Color>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#5F5F5F" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#4A4A4A" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="#3D3D3D" />
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#00A88E" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#005FA8" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#00569B" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobStrokeOn" Color="Transparent" />

            <SolidColorBrush x:Key="SettingsDirectoryBackgroundBrush" Color="#EFF4FA" />
            <SolidColorBrush x:Key="SettingsDirectoryAccentBrush" Color="#316598" />
            <SolidColorBrush x:Key="SettingsJavaBackgroundBrush" Color="#EFF6F2" />
            <SolidColorBrush x:Key="SettingsJavaAccentBrush" Color="#367451" />
            <!-- 原生强调按钮与焦点资源直接引用应用主题画笔，运行中切色也同步。 -->
            <SolidColorBrush x:Key="BrandHoverBrush" Color="#00A88E" />
            <SolidColorBrush x:Key="BrandPressedBrush" Color="#00A88E" />
            <StaticResource x:Key="AccentFillColorDefaultBrush" ResourceKey="BrandBrush" />
            <StaticResource x:Key="AccentFillColorSecondaryBrush" ResourceKey="BrandHoverBrush" />
            <StaticResource x:Key="AccentFillColorTertiaryBrush" ResourceKey="BrandPressedBrush" />
            <StaticResource x:Key="TextOnAccentFillColorPrimaryBrush" ResourceKey="OnBrandTextBrush" />
            <StaticResource x:Key="AccentButtonBackground" ResourceKey="BrandBrush" />
            <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="BrandHoverBrush" />
            <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="BrandPressedBrush" />
            <StaticResource x:Key="AccentButtonForeground" ResourceKey="OnBrandTextBrush" />
            <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="OnBrandTextBrush" />
            <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="OnBrandTextBrush" />
        </ResourceDictionary>

