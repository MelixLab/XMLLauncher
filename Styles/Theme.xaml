        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="NavigationPaneBackgroundBrush" Color="#2B2B2B" />
            <!--
                ★ 底色 = #000000，这是**故意的**，别改回 #202020。

                Windows 在没启用 Mica 时，深色标题栏由 DWM 画成纯黑。
                早先窗口底用的是 #202020、内容层 #1C1C1C，于是屏幕上方一条纯黑、
                下方一片深灰，接缝一眼就能看出来，整体像两个程序拼起来的。

                这里的取向是「内容区去对齐标题栏」，而不是反过来去改标题栏
                （改标题栏会让浅色模式对不上 —— 已经踩过一次）。

                层级不再靠「底色比黑更黑」（黑到底了，没有余量），改成靠
                <b>卡片明度递增</b>来分层：
                    底 #000000 → 卡片 #1C1C1C → 卡片悬停 #262626 → 选中 #2E2E2E
                这样做的好处是：深色下卡片是「浮在黑底上的一块」，比原先
                「深灰底上叠稍浅的灰」层次更清楚，也和 Win11 深色应用的观感一致。
            -->
            <SolidColorBrush x:Key="PaneBackgroundBrush" Color="#000000" />
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#000000" />
            <SolidColorBrush x:Key="BrandBrush" Color="#35D4BA" />
            <SolidColorBrush x:Key="BrandSoftBrush" Color="#12332D" />
            <SolidColorBrush x:Key="OnBrandTextBrush" Color="#04231F" />
                <LinearGradientBrush x:Key="TopFadeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF000000" />
        <GradientStop Offset="1" Color="#00000000" />
    </LinearGradientBrush>
